      "issues": [
        {
          "id": "controller",
          "title": "Modern controllers are not detected and there is no hotplug",
          "when": {},
          "variants": [
            {
              "id": "eaglepatch",
              "status": "unverified",
              "kind": "fix",
              "steps": [
                {
                  "package": "ultimate-asi-loader"
                },
                {
                  "package": "eaglepatch-ac1"
                }
              ],
              "tradeoffs": [
                "Removes DInput controller support (the INI key DisableXInputPatch=1 re-enables it)",
                "The in-game controls layout has no effect; set KeyboardLayout in the INI instead"
              ],
              "sources": [
                {
                  "type": "repo",
                  "url": "https://github.com/Sergeanur/EaglePatch"
                }
              ]
            }
          ]
        },
        {
          "id": "crash-many-threads",
          "title": "Game crashes about 2 s after start on a PC with more than 8 logical processors",
          "when": {
            "cpu.threads": {
              "gt": 8
            }
          },
          "variants": [
            {
              "id": "limit-8-threads",
              "status": "verified",
              "kind": "fix",
              "steps": [
                {
                  "cpu": {
                    "max_threads": 8,
                    "prefer": "performance",
                    "single_l3": true,
                    "smt": false,
                    "mode": "hard"
                  }
                }
              ],
              "tradeoffs": [
                "The game uses at most 8 logical processors (one CCD, no SMT thread pairs); it is a 2008 title, so this costs little"
              ],
              "sources": [
                {
                  "type": "steam-thread",
                  "url": "https://steamcommunity.com/app/15100/discussions/0/3369279631097585577/"
                },
                {
                  "type": "steam-thread",
                  "url": "https://steamcommunity.com/app/15100/discussions/0/5299051083531295561/"
                },
                {
                  "type": "steam-guide",
                  "url": "https://steamcommunity.com/sharedfiles/filedetails/?id=3276044556"
                }
              ]
            }
          ]
        },
        {
          "id": "online-services",
          "title": "Game crashes at the Ubisoft logo intro (shut-down online services)",
          "when": {},
          "variants": [
            {
              "id": "eaglepatch",
              "status": "verified",
              "kind": "fix",
              "steps": [
                {
                  "package": "ultimate-asi-loader"
                },
                {
                  "package": "eaglepatch-ac1"
                }
              ],
              "tradeoffs": [
                "Removes DInput controller support (the INI key DisableXInputPatch=1 re-enables it)",
                "The in-game controls layout has no effect; set KeyboardLayout in the INI instead"
              ],
              "sources": [
                {
                  "type": "repo",
                  "url": "https://github.com/Sergeanur/EaglePatch"
                },
                {
                  "type": "pcgw",
                  "url": "https://www.pcgamingwiki.com/wiki/Assassin%27s_Creed#Game_regularly_freezes_for_a_few_seconds"
                }
              ]
            }
          ]
        }
      ],
      "tips": {
        "notes": [
          {
            "text": "Manual, not done by Rerun: the game can be stopped from contacting the shut-down Ubisoft server by overwriting the host name gconnect.ubi.com in AssassinsCreed_Dx9.exe or AssassinsCreed_Dx10.exe with zero bytes in a hex editor. Keep a copy of the original exe: a changed exe no longer matches EaglePatch's supported builds or this Topo, and Smart App Control may block it. Steam's 'Verify integrity of game files' restores the original.",
            "source": {
              "type": "pcgw",
              "url": "https://www.pcgamingwiki.com/wiki/Assassin%27s_Creed#Game_regularly_freezes_for_a_few_seconds"
            }
          }
        ]
      },
      "links": {
        "pcgw": "Assassin's_Creed"
      }
