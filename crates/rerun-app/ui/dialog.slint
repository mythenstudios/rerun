// The undo, forget and download dialogs, and the third-party licences (P5-10e).

import { ListView, ScrollView } from "std-widgets.slint";
import { Button, DetailLine, Muted, PageTitle, PartsLine } from "base.slint";
import { DialogData, LicenceData, ListData, Str, Theme, Modal } from "base.slint";
import { OpItem, WarnLine } from "ops.slint";

// The undo, forget and download dialogs: what the operation meets (or what would be downloaded),
// before the click; and the wait for the UAC dialog (P5-5c, no button: the window waits for
// Windows). Esc closes (the window ignores it while it waits for Windows). While it
// is open `Modal.open` is set and only its controls can take the focus (a focus trap); the title
// takes the focus when it opens.
export component DialogView inherits Rectangle {
    in property <DialogData> d;
    callback confirm();
    callback cancel();
    callback secondary();
    background: Theme.bg.with-alpha(0.85);
    // Keeps the mouse from reaching the page behind.
    TouchArea { }

    FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.cancel();
                return accept;
            }
            reject
        }
        VerticalLayout {
            alignment: center;
            padding: Theme.s6;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: min(root.width - Theme.s8, Theme.s8 * 14);
                    height: root.height - Theme.s8 * 2;
                    background: Theme.raised;
                    border-radius: Theme.radius-m;
                    border-width: Theme.hair;
                    border-color: Theme.line-strong;
                    accessible-role: groupbox;
                    accessible-label: root.d.title;
                    VerticalLayout {
                        padding: Theme.s6;
                        spacing: Theme.s4;
                        PageTitle {
                            text: root.d.title;
                            size: Theme.fs-l;
                            family: Theme.font-sans;
                        }

                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: Theme.s3;
                                if root.d.changed != "": Rectangle {
                                    background: Theme.raised2;
                                    border-radius: Theme.radius-s;
                                    accessible-role: AccessibleRole.text;
                                    accessible-label: root.d.changed;
                                    VerticalLayout {
                                        padding: Theme.s3;
                                        Text {
                                            text: root.d.changed;
                                            color: Theme.strong;
                                            font-size: Theme.fs-m;
                                            wrap: word-wrap;
                                            accessible-role: none;
                                        }
                                    }
                                }
                                Muted {
                                    text: root.d.intro;
                                }

                                for op in root.d.ops: OpItem {
                                    op: op;
                                }
                                for l in root.d.lists: list := VerticalLayout {
                                    // A list with a `show` label is folded until its button opens it.
                                    in-out property <bool> open: false;
                                    spacing: Theme.s1;
                                    accessible-role: groupbox;
                                    accessible-label: l.heading + l.subject;
                                    if l.heading != "": Text {
                                        text: l.heading;
                                        color: Theme.strong;
                                        font-size: Theme.fs-m;
                                        font-weight: 600;
                                        wrap: word-wrap;
                                    }
                                    if l.subject != "": Text {
                                        text: l.subject;
                                        color: Theme.strong;
                                        font-size: Theme.fs-m;
                                        font-weight: 600;
                                        wrap: word-wrap;
                                    }

                                    if l.show != "": HorizontalLayout {
                                        alignment: start;
                                        Button {
                                            in-dialog: true;
                                            text: list.open ? l.hide : l.show;
                                            accessible-label: (list.open ? l.hide : l.show) + ": " + l.heading + l.subject;
                                            activated => {
                                                list.open = !list.open;
                                            }
                                        }
                                    }
                                    if l.show == "" || list.open: VerticalLayout {
                                        spacing: Theme.s1;
                                        for line in l.lines: PartsLine {
                                            p: line;
                                            mono: l.show != "";
                                        }
                                    }
                                }
                                for n in root.d.notes: Text {
                                    text: n;
                                    color: Theme.text;
                                    font-size: Theme.fs-m;
                                    wrap: word-wrap;
                                }
                                for x in root.d.details: DetailLine {
                                    d: x;
                                }
                                if root.d.has-launch: Rectangle {
                                    background: Theme.raised2;
                                    border-radius: Theme.radius-s;
                                    accessible-role: groupbox;
                                    accessible-label: root.d.launch-heading;
                                    VerticalLayout {
                                        padding: Theme.s4;
                                        spacing: Theme.s2;
                                        Text {
                                            text: root.d.launch-heading;
                                            color: Theme.strong;
                                            font-size: Theme.fs-m;
                                            font-weight: 600;
                                        }

                                        for line in root.d.launch-lines: Muted {
                                            text: line;
                                        }
                                        if root.d.launch-option != "": Text {
                                            text: root.d.launch-option;
                                            color: Theme.text;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.fs-s + Theme.hair;
                                            wrap: word-wrap;
                                        }
                                        for p in root.d.launch-problems: WarnLine {
                                            w: p;
                                        }
                                    }
                                }
                                if root.d.blocked != "": Text {
                                    text: root.d.blocked;
                                    color: Theme.strong;
                                    font-size: Theme.fs-m;
                                    font-weight: 600;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: Theme.s3;
                            alignment: end;
                            if !root.d.no-cancel: Button {
                                in-dialog: true;
                                text: root.d.cancel-label != "" ? root.d.cancel-label : Str.btn-cancel;
                                enabled: !root.d.cancel-disabled;
                                activated => {
                                    root.cancel();
                                }
                            }

                            if root.d.secondary != "": Button {
                                in-dialog: true;
                                text: root.d.secondary;
                                enabled: !Modal.working;
                                activated => {
                                    root.secondary();
                                }
                            }

                            if !root.d.no-confirm: Button {
                                in-dialog: true;
                                primary: true;
                                text: root.d.confirm;
                                enabled: root.d.can-confirm && !Modal.working;
                                activated => {
                                    root.confirm();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// The third-party licences (P5-10e): the entries of the embedded notices file in a virtualised
// list, each the crates (or font, or Rerun) that ship a text, then the text in the monospace
// face. Read only. Esc and "Close" close it; while it is open `Modal.open` is set (a focus
// trap, as for the other dialogs) and the title takes the focus. The arrow keys, Page Up/Down,
// Home and End scroll the list.
export component LicencesView inherits Rectangle {
    in property <string> intro;
    in property <[LicenceData]> entries;
    callback close();
    background: Theme.bg.with-alpha(0.85);
    // Keeps the mouse from reaching the page behind.
    TouchArea { }

    FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.close();
                return accept;
            }
            if (e.text == Key.DownArrow) {
                root.scroll(-Theme.s6);
                return accept;
            }
            if (e.text == Key.UpArrow) {
                root.scroll(Theme.s6);
                return accept;
            }
            if (e.text == Key.PageDown) {
                root.scroll(-list.visible-height * 0.9);
                return accept;
            }
            if (e.text == Key.PageUp) {
                root.scroll(list.visible-height * 0.9);
                return accept;
            }
            if (e.text == Key.Home) {
                list.content-y = 0;
                return accept;
            }
            if (e.text == Key.End) {
                list.content-y = min(0, list.visible-height - list.content-height);
                return accept;
            }
            reject
        }
        VerticalLayout {
            alignment: center;
            padding: Theme.s6;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: min(root.width - Theme.s8, Theme.s8 * 16);
                    height: root.height - Theme.s8 * 2;
                    background: Theme.raised;
                    border-radius: Theme.radius-m;
                    border-width: Theme.hair;
                    border-color: Theme.line-strong;
                    accessible-role: groupbox;
                    accessible-label: Str.about-licences;
                    VerticalLayout {
                        padding: Theme.s6;
                        spacing: Theme.s4;
                        PageTitle {
                            text: Str.about-licences;
                            size: Theme.fs-l;
                            family: Theme.font-sans;
                        }

                        Muted {
                            text: root.intro;
                        }

                        list := ListView {
                            vertical-stretch: 1;
                            for e in root.entries: VerticalLayout {
                                padding-top: Theme.s4;
                                padding-bottom: Theme.s4;
                                padding-right: Theme.s4;
                                spacing: Theme.s2;
                                accessible-role: groupbox;
                                accessible-label: e.heading;
                                Rectangle {
                                    height: Theme.hair;
                                    background: Theme.line-soft;
                                }

                                Text {
                                    text: e.heading;
                                    color: Theme.strong;
                                    font-size: Theme.fs-m;
                                    font-weight: 600;
                                    wrap: word-wrap;
                                }

                                Text {
                                    text: e.text;
                                    color: Theme.text;
                                    font-family: Theme.font-mono;
                                    font-size: Theme.fs-s;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        HorizontalLayout {
                            alignment: end;
                            Button {
                                in-dialog: true;
                                primary: true;
                                text: Str.licences-close;
                                activated => {
                                    root.close();
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    function scroll(by: length) {
        list.content-y = min(0, max(list.visible-height - list.content-height, list.content-y + by));
    }
}
