// The window of rerun-app (docs/07-ui.md, layout C, theme "Mythen"). Only `rerun-app::ui` and
// `build.rs` know this file (ADR 0026). Every colour and size comes from the global `Theme`,
// which `ui` fills from `theme::tokens`; every string comes from `Str` or a view model, both
// filled from `text` and `vm`. Untrusted text (Steam names, paths, Topo texts, error details)
// is always drawn in its own `Text` element (ADR 0016, ADR 0026).

import { ScrollView, LineEdit } from "std-widgets.slint";

// The brand fonts (OFL, assets/fonts/FONTS.md), embedded into the binary at build time. Only the
// weights the theme uses. A glyph they lack (Cyrillic, CJK) falls back to a system font.
import "../assets/fonts/archivo/ArchivoExpanded-ExtraBold.ttf";
import "../assets/fonts/ibm-plex-sans/IBMPlexSans-Regular.ttf";
import "../assets/fonts/ibm-plex-sans/IBMPlexSans-Medium.ttf";
import "../assets/fonts/ibm-plex-sans/IBMPlexSans-SemiBold.ttf";
import "../assets/fonts/ibm-plex-mono/IBMPlexMono-Regular.ttf";
import "../assets/fonts/ibm-plex-mono/IBMPlexMono-Medium.ttf";

// ---------------------------------------------------------------- data from the view models

export struct BadgeData {
    sym: string,
    word: string,
    quiet: bool,
}

export struct RowData {
    app-id: int,
    name: string,
    detail: string,
    exe: string,
    badge: BadgeData,
}

export struct SectionData {
    title: string,
    rows: [RowData],
}

export struct DetailData {
    who: string,
    what: string,
}

export struct NoticeData {
    title: string,
    body: string,
    details: [DetailData],
}

// One labelled line of an op; every value is drawn in its own element.
export struct LineData {
    label: string,
    values: [string],
    mono: bool,
}

// One op of a plan or of a transaction, with what undo does with it (and, in an undo dialog,
// what it would meet now).
export struct OpData {
    index: int,
    action: string,
    target: string,
    lines: [LineData],
    undo: string,
    fate-sym: string,
    fate-word: string,
}

export struct WarnData {
    sym: string,
    word: string,
    text: string,
    detail: string,
}

export struct LaunchData {
    heading: string,
    lines: [string],
    intro: string,
    option: string,
    notes: [string],
    problems: [WarnData],
    copy: string,
    copied: string,
}

// state: 0 nothing selected, 1 planning, 2 shown, 3 refused.
export struct PreviewData {
    state: int,
    hash: string,
    summary: string,
    folder: string,
    ops: [OpData],
    warnings: [WarnData],
    notes: [string],
    has-launch: bool,
    launch: LaunchData,
    admin: string,
    undo: string,
    can-apply: bool,
    nothing: string,
    ready: bool,
    refused: NoticeData,
}

export struct CardData {
    id: string,
    game: string,
    state: BadgeData,
    problem: string,
    ops: [OpData],
    note: string,
    can-undo: bool,
    can-forget: bool,
}

// kind: 0 undo, 1 forget.
export struct DialogData {
    kind: int,
    title: string,
    intro: string,
    changed: string,
    ops: [OpData],
    notes: [string],
    details: [DetailData],
    has-launch: bool,
    launch-heading: string,
    launch-lines: [string],
    launch-option: string,
    launch-problems: [WarnData],
    confirm: string,
    can-confirm: bool,
    blocked: string,
}

// tone: 0 done, 1 calm, 2 attention.
export struct BannerData {
    tone: int,
    sym: string,
    title: string,
    body: string,
    details: [DetailData],
}

export struct FactData {
    label: string,
    value: string,
    mono: bool,
}

export struct ProblemData {
    title: string,
    when: BadgeData,
    fixes: [string],
    quiet: bool,
}

export struct SolvedData {
    issue: string,
    when: BadgeData,
    status: BadgeData,
    tradeoffs: [string],
    sources: [string],
}

export struct FixData {
    id: string,
    kind: string,
    state: BadgeData,
    refused: string,
    refused-detail: string,
    warned: string,
    solves: [SolvedData],
    selectable: bool,
    selected: bool,
    note: string,
    preselect-note: string,
    exclusive: [string],
}

export struct GameData {
    app-id: int,
    title: string,
    hero-sym: string,
    hero-line: string,
    hero-sub: string,
    facts: [FactData],
    notes: [string],
    detail: string,
    problems: [ProblemData],
    fixes: [FixData],
    applied: [CardData],
}

export struct AppliedData {
    sym: string,
    title: string,
    sub: string,
    detail: string,
    cards: [CardData],
}

export struct SysLineData {
    label: string,
    values: [string],
}

// ---------------------------------------------------------------- tokens and strings

export global Theme {
    in property <color> bg;
    in property <color> raised;
    in property <color> raised2;
    in property <color> raised3;
    in property <color> raised4;
    in property <color> line-soft;
    in property <color> line;
    in property <color> line-strong;
    in property <color> text;
    in property <color> strong;
    in property <color> muted;
    in property <color> faint;
    in property <color> on-strong;
    in property <color> danger;
    in property <length> hair;
    in property <length> radius-s;
    in property <length> radius-m;
    in property <length> s1;
    in property <length> s2;
    in property <length> s3;
    in property <length> s4;
    in property <length> s5;
    in property <length> s6;
    in property <length> s7;
    in property <length> s8;
    in property <length> fs-xs;
    in property <length> fs-s;
    in property <length> fs-m;
    in property <length> fs-l;
    in property <length> fs-group;
    in property <length> fs-page;
    in property <length> fs-hero;
    in property <length> row-h;
    in property <length> title-h;
    // `caption-w`, `title-h` and `resize-border` are also the hit-test geometry of the
    // snap-layout subclass (`ui::chrome`): change them here and the hit area follows.
    in property <length> caption-w;
    in property <length> resize-border;
    in property <length> nav-w;
    in property <string> font-sans;
    in property <string> font-display;
    in property <string> font-mono;
    in property <string> font-symbol;
    in property <string> font-icons;
}

export global Str {
    in property <string> app-name;
    in property <string> by;
    in property <string> minimize;
    in property <string> maximize;
    in property <string> restore;
    in property <string> close;
    in property <string> nav-label;
    in property <[string]> nav;
    in property <string> no-background;
    in property <string> first-run-title;
    in property <[string]> first-run-leads;
    in property <[string]> first-run-texts;
    in property <string> first-run-dismiss;
    in property <string> library-title;
    in property <string> library-reading;
    in property <string> search-label;
    in property <string> search-placeholder;
    in property <string> group-by-status;
    in property <string> view-label;
    in property <string> view-list;
    in property <string> no-search-match;
    in property <string> rescan;
    in property <string> show-problems;
    in property <string> hide-problems;
    in property <string> detail;
    in property <string> back;
    in property <string> eyebrow;
    in property <string> game-reading;
    in property <string> facts-label;
    in property <string> problems-title;
    in property <string> problem-fixes;
    in property <string> problem-no-fix;
    in property <string> fixes-title;
    in property <string> fixes-intro;
    in property <string> fixes-read-only;
    in property <string> fix-solves;
    in property <string> applied-title;
    in property <string> applied-intro;
    in property <string> history-title;
    in property <string> history-intro;
    in property <string> history-later;
    in property <string> system-title;
    in property <string> system-intro;
    in property <string> system-reading;
    in property <string> settings-title;
    in property <string> settings-intro;
    in property <string> settings-safety;
    in property <string> set-preview;
    in property <string> set-preview-desc;
    in property <string> set-sources;
    in property <string> set-sources-desc;
    in property <string> always-on;
    in property <string> settings-look;
    in property <string> set-theme;
    in property <string> theme-name;
    in property <string> set-language;
    in property <string> language-name;
    in property <string> settings-about;
    in property <string> about-version;
    in property <string> about-licence;
    // Selecting, previewing, applying and undoing (P5-5a).
    in property <string> fix-select;
    in property <string> fix-tradeoffs;
    in property <string> fix-no-tradeoffs;
    in property <string> fix-sources;
    in property <string> fix-exclusive;
    in property <string> preview-title;
    in property <string> preview-none;
    in property <string> preview-planning;
    in property <string> preview-intro;
    in property <string> preview-folder;
    in property <string> preview-checksum;
    in property <string> preview-close-game;
    in property <string> preview-applying;
    in property <string> btn-apply;
    in property <string> btn-cancel;
    in property <string> btn-dismiss;
    in property <string> btn-undo;
    in property <string> btn-forget;
    in property <string> lbl-undo;
    in property <string> applied-here;
    in property <string> card-game;
    in property <string> card-txn;
    in property <string> working;
}

// Keeps the focused element visible: every focusable element asks for it, `ui` hands it to
// `AppWindow.reveal`, which scrolls the page.
export global Reveal {
    callback request(length, length);
}

// A dialog is open: everything outside it cannot take the focus (a focus trap; Tab cycles in
// the dialog). `return-to` is the card button that takes the focus back when the dialog closes
// (`ui` sets it then): 2 * card index for "Undo", 2 * card index + 1 for "Close without undoing".
export global Modal {
    in-out property <bool> open;
    in-out property <int> return-to: -1;
    // A write is running: the apply and undo buttons wait.
    in-out property <bool> working;
}

// ---------------------------------------------------------------- building blocks

// Focusable and keyboard-clickable (Enter, Space), with a focus ring after keyboard focus only.
component Pressable inherits FocusScope {
    in property <length> radius: Theme.radius-m;
    in property <length> ring-inset: 0px;
    out property <bool> kb-focus;
    out property <bool> hovered: ta.has-hover;
    out property <bool> pressed: ta.pressed;
    // Set on the controls of a dialog: while one is open only they can take the focus.
    in property <bool> in-dialog: false;
    // Takes the focus when it turns true (the opener of a closed dialog gets it back).
    in property <bool> take-focus: false;
    callback activated();
    enabled: !Modal.open || root.in-dialog;
    changed take-focus => {
        if (root.take-focus) {
            root.focus();
        }
    }
    focus-gained(reason) => {
        root.kb-focus = reason == FocusReason.tab-navigation;
        Reveal.request(self.absolute-position.y, self.height);
    }
    focus-lost(reason) => {
        root.kb-focus = false;
    }
    key-pressed(e) => {
        if (e.text == Key.Return || e.text == " ") {
            root.activated();
            return accept;
        }
        reject
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }

    @children
    Rectangle {
        x: root.ring-inset;
        y: root.ring-inset;
        width: root.width - 2 * root.ring-inset;
        height: root.height - 2 * root.ring-inset;
        border-width: root.kb-focus ? 2 * Theme.hair : 0px;
        border-color: Theme.strong;
        border-radius: root.radius;
    }
}

// A page or section title that takes the focus when its page opens, so a screen reader reads
// the page's name (Slint has no heading role, ADR 0026).
component PageTitle inherits FocusScope {
    in property <string> text;
    in property <length> size: Theme.fs-page;
    in property <string> family: Theme.font-display;
    focus-on-tab-navigation: false;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    init => {
        self.focus();
    }
    Text {
        width: 100%;
        text: root.text;
        font-family: root.family;
        font-size: root.size;
        font-weight: 800;
        color: Theme.strong;
        wrap: word-wrap;
        accessible-role: none;
    }
}

component Badge inherits Rectangle {
    in property <BadgeData> data;
    accessible-role: AccessibleRole.text;
    accessible-label: root.data.word;
    background: root.data.quiet ? Theme.raised2 : Theme.line-soft;
    border-width: root.data.quiet ? Theme.hair : 0px;
    border-color: Theme.line-strong;
    border-radius: Theme.radius-s;
    HorizontalLayout {
        padding-left: Theme.s2;
        padding-right: Theme.s2;
        padding-top: Theme.hair * 2;
        padding-bottom: Theme.hair * 2;
        spacing: Theme.s1 + Theme.hair * 2;
        Text {
            text: root.data.sym;
            color: Theme.muted;
            font-size: Theme.fs-s;
            font-family: Theme.font-symbol;
            vertical-alignment: center;
            accessible-role: none;
        }

        Text {
            text: root.data.word;
            color: Theme.strong;
            font-size: Theme.fs-s;
            font-weight: 500;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

component Button inherits Pressable {
    in property <string> text;
    in property <bool> primary;
    // A disabled button (a dialog is open, a write runs, nothing to apply) is drawn quiet.
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.activated();
    }
    ring-inset: -3px;
    min-height: Theme.s6 + Theme.s1 + Theme.hair * 2;
    Rectangle {
        border-radius: Theme.radius-m;
        background: !root.enabled ? Theme.raised2 : root.primary ? (root.hovered ? Theme.text : Theme.strong) : (root.hovered ? Theme.raised4 : Theme.raised3);
    }

    HorizontalLayout {
        padding-left: Theme.s4;
        padding-right: Theme.s4;
        Text {
            text: root.text;
            color: !root.enabled ? Theme.faint : root.primary ? Theme.on-strong : Theme.strong;
            font-size: Theme.fs-m;
            font-weight: root.primary ? 600 : 500;
            vertical-alignment: center;
            horizontal-alignment: center;
            accessible-role: none;
        }
    }
}

component Toggle inherits Pressable {
    in-out property <bool> checked;
    in property <string> text;
    callback toggled(bool);
    ring-inset: -3px;
    accessible-role: switch;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-label: root.text;
    accessible-action-default => {
        root.activated();
    }
    activated => {
        root.checked = !root.checked;
        root.toggled(root.checked);
    }
    HorizontalLayout {
        spacing: Theme.s3;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: Theme.s6 + Theme.s1;
                height: Theme.s4 + Theme.s1;
                border-radius: self.height / 2;
                background: root.checked ? Theme.strong : Theme.line;
                Rectangle {
                    width: parent.height - 6px;
                    height: self.width;
                    border-radius: self.width / 2;
                    x: root.checked ? parent.width - self.width - 3px : 3px;
                    y: 3px;
                    background: root.checked ? Theme.bg : Theme.muted;
                }
            }
        }

        Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.fs-m;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

component NavItem inherits Pressable {
    in property <string> sym;
    in property <string> text;
    in property <string> count;
    in property <bool> active;
    height: Theme.s7 + Theme.s1;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selectable: true;
    accessible-item-selected: root.active;
    accessible-action-default => {
        root.activated();
    }
    Rectangle {
        border-radius: Theme.radius-m;
        background: root.active ? Theme.raised2 : (root.hovered ? Theme.raised : transparent);
    }

    HorizontalLayout {
        padding-left: Theme.s3 + Theme.hair * 2;
        padding-right: Theme.s3 + Theme.hair * 2;
        spacing: Theme.s3;
        Text {
            width: Theme.s4 + Theme.s1;
            text: root.sym;
            color: Theme.muted;
            font-family: Theme.font-symbol;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }

        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: root.active ? Theme.strong : Theme.text;
            font-size: Theme.fs-m;
            font-weight: root.active ? 600 : 500;
            vertical-alignment: center;
            accessible-role: none;
        }

        Text {
            text: root.count;
            color: Theme.muted;
            font-size: Theme.fs-s;
            font-family: Theme.font-mono;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

component CaptionButton inherits Pressable {
    in property <string> glyph;
    in property <string> label;
    in property <bool> danger;
    // Set by `ui::chrome` while Windows owns the mouse over the maximise button (HTMAXBUTTON
    // for the snap layouts): Slint does not see those mouse moves.
    in property <bool> nc-hover;
    width: Theme.caption-w;
    radius: 0px;
    in-dialog: true;
    focus-on-tab-navigation: false;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.activated();
    }
    Rectangle {
        background: (root.hovered || root.nc-hover) ? (root.danger ? Theme.danger : Theme.raised3) : transparent;
    }

    Text {
        text: root.glyph;
        font-family: Theme.font-icons;
        font-size: Theme.fs-xs - Theme.hair;
        color: Theme.strong;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

component Hairline inherits Rectangle {
    background: Theme.line-soft;
}

component Muted inherits Text {
    color: Theme.muted;
    font-size: Theme.fs-m;
    wrap: word-wrap;
}

component GroupHeading inherits Text {
    color: Theme.strong;
    font-size: Theme.fs-group;
    font-weight: 600;
    wrap: word-wrap;
}

// One detail: what it is about and the core's text, each in its own element.
component DetailLine inherits HorizontalLayout {
    in property <DetailData> d;
    spacing: Theme.s2;
    if root.d.who != "": Text {
        text: root.d.who;
        color: Theme.text;
        font-size: Theme.fs-s;
        font-weight: 600;
        vertical-alignment: top;
    }
    Text {
        horizontal-stretch: 1;
        text: root.d.what;
        color: Theme.muted;
        font-size: Theme.fs-s;
        font-family: Theme.font-mono;
        wrap: word-wrap;
    }
}

component NoticeCard inherits Rectangle {
    in property <NoticeData> n;
    in-out property <bool> open;
    background: Theme.raised;
    border-radius: Theme.radius-m;
    accessible-role: groupbox;
    accessible-label: root.n.title;
    // The strong left rule of a callout.
    Rectangle {
        x: 0;
        width: Theme.hair * 2;
        background: Theme.strong;
    }

    VerticalLayout {
        padding: Theme.s5;
        padding-left: Theme.s5 + Theme.hair * 2;
        spacing: Theme.s2;
        Text {
            text: root.n.title;
            color: Theme.strong;
            font-size: Theme.fs-l;
            font-weight: 600;
            wrap: word-wrap;
        }

        Muted {
            text: root.n.body;
        }

        if root.n.details.length > 0 && root.n.details.length <= 1: VerticalLayout {
            spacing: Theme.s1;
            for d in root.n.details: DetailLine {
                d: d;
            }
        }
        if root.n.details.length > 1: HorizontalLayout {
            alignment: start;
            Button {
                text: root.open ? Str.hide-problems : Str.show-problems;
                activated => {
                    root.open = !root.open;
                }
            }
        }
        if root.n.details.length > 1 && root.open: VerticalLayout {
            spacing: Theme.s1;
            for d in root.n.details: DetailLine {
                d: d;
            }
        }
    }
}

component RowItem inherits Pressable {
    in property <RowData> item;
    in property <int> index;
    in property <int> count;
    radius: 0px;
    ring-inset: Theme.hair;
    min-height: Theme.row-h;
    accessible-role: list-item;
    // Untrusted text (the Steam name) is never joined with other text: the name is the label,
    // Rerun's own words are the description.
    accessible-label: root.item.name;
    accessible-description: root.item.detail + ", " + root.item.badge.word;
    accessible-item-index: root.index;
    accessible-item-count: root.count;
    accessible-action-default => {
        root.activated();
    }
    Rectangle {
        background: root.hovered ? Theme.raised2 : transparent;
    }

    if root.index > 0: Hairline {
        y: 0;
        height: Theme.hair;
    }
    HorizontalLayout {
        padding-left: Theme.s5;
        padding-right: Theme.s5;
        padding-top: Theme.s3;
        padding-bottom: Theme.s3;
        spacing: Theme.s4;
        Text {
            width: Theme.s5;
            text: root.item.badge.sym;
            color: Theme.muted;
            font-family: Theme.font-symbol;
            font-size: Theme.fs-l;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: Theme.hair * 2;
            Text {
                text: root.item.name;
                color: Theme.strong;
                font-size: Theme.fs-l;
                font-weight: 600;
                overflow: elide;
                accessible-role: none;
            }

            HorizontalLayout {
                spacing: Theme.s2;
                alignment: start;
                Text {
                    text: root.item.detail;
                    color: Theme.muted;
                    font-size: Theme.fs-m;
                    accessible-role: none;
                }

                if root.item.exe != "": Text {
                    text: root.item.exe;
                    color: Theme.muted;
                    font-size: Theme.fs-s;
                    font-family: Theme.font-mono;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: none;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            Badge {
                data: root.item.badge;
                accessible-role: none;
            }
        }

        Text {
            text: "\u{203A}";
            color: Theme.muted;
            font-size: Theme.fs-l;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

component Card inherits Rectangle {
    background: Theme.raised;
    border-radius: Theme.radius-m;
}

component Setting inherits Rectangle {
    in property <string> title;
    in property <string> desc;
    in property <string> value;
    in property <bool> first;
    accessible-role: AccessibleRole.text;
    accessible-label: root.title + ", " + root.value;
    accessible-description: root.desc;
    if !root.first: Hairline {
        y: 0;
        height: Theme.hair;
    }
    HorizontalLayout {
        padding: Theme.s5;
        spacing: Theme.s4;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Theme.s1;
            Text {
                text: root.title;
                color: Theme.strong;
                font-size: Theme.fs-l;
                font-weight: 600;
                wrap: word-wrap;
                accessible-role: none;
            }

            if root.desc != "": Text {
                text: root.desc;
                color: Theme.muted;
                font-size: Theme.fs-m;
                wrap: word-wrap;
                accessible-role: none;
            }
        }

        Text {
            text: root.value;
            color: Theme.text;
            font-size: Theme.fs-m;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

// ---------------------------------------------------------------- pages

component FirstRunCard inherits Rectangle {
    callback dismiss();
    background: Theme.raised;
    border-radius: Theme.radius-m;
    accessible-role: groupbox;
    accessible-label: Str.first-run-title;
    Rectangle {
        x: 0;
        width: Theme.hair * 2;
        background: Theme.strong;
    }

    VerticalLayout {
        padding: Theme.s5;
        padding-left: Theme.s5 + Theme.hair * 2;
        spacing: Theme.s3;
        Text {
            text: Str.first-run-title;
            color: Theme.strong;
            font-size: Theme.fs-l + Theme.s1;
            font-weight: 600;
        }

        for lead[i] in Str.first-run-leads: HorizontalLayout {
            spacing: Theme.s3;
            Text {
                text: i + 1;
                width: Theme.s4;
                color: Theme.muted;
                font-family: Theme.font-mono;
                font-size: Theme.fs-m;
                accessible-role: none;
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.hair * 2;
                Text {
                    text: lead;
                    color: Theme.strong;
                    font-size: Theme.fs-m;
                    font-weight: 600;
                    wrap: word-wrap;
                }

                Muted {
                    text: Str.first-run-texts[i];
                }
            }
        }
        HorizontalLayout {
            alignment: start;
            Button {
                text: Str.first-run-dismiss;
                activated => {
                    root.dismiss();
                }
            }
        }
    }
}

component LibraryPage inherits VerticalLayout {
    in property <bool> reading;
    in property <string> summary;
    in property <[NoticeData]> notices;
    in property <[SectionData]> sections;
    in property <int> shown;
    in property <string> list-label;
    in-out property <string> query;
    in-out property <bool> group;
    in-out property <bool> first-run;
    callback query-edited(string);
    callback group-toggled(bool);
    callback open-game(int);
    callback rescan();
    spacing: Theme.s4;
    PageTitle {
        text: Str.library-title;
    }

    if root.first-run: FirstRunCard {
        dismiss => {
            root.first-run = false;
        }
    }
    Muted {
        text: root.reading ? Str.library-reading : root.summary;
    }

    for n in root.notices: NoticeCard {
        n: n;
    }
    HorizontalLayout {
        spacing: Theme.s5;
        alignment: start;
        VerticalLayout {
            spacing: Theme.s1;
            width: Theme.s8 * 6;
            Text {
                text: Str.search-label;
                color: Theme.muted;
                font-size: Theme.fs-s;
                accessible-role: none;
            }

            LineEdit {
                text <=> root.query;
                placeholder-text: Str.search-placeholder;
                accessible-label: Str.search-label;
                edited(t) => {
                    root.query-edited(t);
                }
            }
        }

        VerticalLayout {
            alignment: end;
            Toggle {
                text: Str.group-by-status;
                checked <=> root.group;
                toggled(v) => {
                    root.group-toggled(v);
                }
            }
        }
    }

    if !root.reading && root.shown == 0 && root.query != "": Muted {
        text: Str.no-search-match;
    }
    VerticalLayout {
        spacing: Theme.s3;
        accessible-role: list;
        accessible-label: root.list-label;
        for s in root.sections: VerticalLayout {
            spacing: Theme.s3;
            padding-top: Theme.s3;
            GroupHeading {
                text: s.title;
            }

            Card {
                VerticalLayout {
                    for r[i] in s.rows: RowItem {
                        item: r;
                        index: i;
                        count: s.rows.length;
                        activated => {
                            root.open-game(r.app-id);
                        }
                    }
                }
            }
        }
    }

    if !root.reading: HorizontalLayout {
        alignment: start;
        padding-top: Theme.s3;
        Button {
            text: Str.rescan;
            activated => {
                root.rescan();
            }
        }
    }
}

// A checkbox: a square with a tick, the state in the tick and in the screen reader's checked
// state. The page sets `checked` (the selection lives in `ui`); a click only asks.
component Check inherits Pressable {
    in property <bool> checked;
    in property <string> text;
    // The name a screen reader reads (the visible text may be shorter).
    in property <string> a11y;
    ring-inset: -3px;
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-label: root.a11y != "" ? root.a11y : root.text;
    accessible-action-default => {
        root.activated();
    }
    HorizontalLayout {
        spacing: Theme.s3;
        padding: Theme.s2;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: Theme.s5;
                height: Theme.s5;
                border-width: Theme.hair * 2;
                border-color: Theme.strong;
                background: root.checked ? Theme.strong : transparent;
                Text {
                    text: root.checked ? "\u{2713}" : "";
                    color: Theme.on-strong;
                    font-family: Theme.font-symbol;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
        }

        Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.fs-m;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

// A warning: glyph and word, the sentence, and what it is about in its own element.
component WarnLine inherits Rectangle {
    in property <WarnData> w;
    background: Theme.raised2;
    border-radius: Theme.radius-s;
    accessible-role: AccessibleRole.text;
    accessible-label: root.w.word + ": " + root.w.text;
    accessible-description: root.w.detail;
    Rectangle {
        x: 0;
        width: Theme.hair * 2;
        background: Theme.line-strong;
    }

    HorizontalLayout {
        padding: Theme.s3;
        padding-left: Theme.s4;
        spacing: Theme.s3;
        Text {
            text: root.w.sym;
            color: Theme.muted;
            font-family: Theme.font-symbol;
            font-size: Theme.fs-m;
            accessible-role: none;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Theme.s1;
            Text {
                text: root.w.word + ": " + root.w.text;
                color: Theme.text;
                font-size: Theme.fs-m;
                wrap: word-wrap;
                accessible-role: none;
            }

            if root.w.detail != "": Text {
                text: root.w.detail;
                color: Theme.muted;
                font-family: Theme.font-mono;
                font-size: Theme.fs-s;
                wrap: word-wrap;
                accessible-role: none;
            }
        }
    }
}

// One op: what it does, where, every detail, and what undo does with it.
component OpItem inherits Rectangle {
    in property <OpData> op;
    background: Theme.raised2;
    border-radius: Theme.radius-s;
    accessible-role: groupbox;
    accessible-label: root.op.action;
    accessible-description: root.op.target;
    VerticalLayout {
        padding: Theme.s3;
        padding-left: Theme.s4;
        padding-right: Theme.s4;
        spacing: Theme.s1;
        HorizontalLayout {
            spacing: Theme.s3;
            Text {
                text: root.op.action;
                color: Theme.strong;
                font-size: Theme.fs-m;
                font-weight: 600;
                vertical-alignment: top;
                accessible-role: none;
            }

            Text {
                horizontal-stretch: 1;
                text: root.op.target;
                color: Theme.text;
                font-family: Theme.font-mono;
                font-size: Theme.fs-s + Theme.hair;
                wrap: word-wrap;
                accessible-role: none;
            }
        }

        for l in root.op.lines: HorizontalLayout {
            spacing: Theme.s3;
            accessible-role: AccessibleRole.text;
            accessible-label: l.label;
            Text {
                width: Theme.s8 * 2;
                text: l.label;
                color: Theme.muted;
                font-size: Theme.fs-s;
                wrap: word-wrap;
                accessible-role: none;
            }

            VerticalLayout {
                horizontal-stretch: 1;
                for v in l.values: Text {
                    text: v;
                    color: Theme.text;
                    font-family: l.mono ? Theme.font-mono : Theme.font-sans;
                    font-size: l.mono ? Theme.fs-s : Theme.fs-m;
                    wrap: word-wrap;
                    accessible-role: none;
                }
            }
        }

        if root.op.fate-word != "": HorizontalLayout {
            spacing: Theme.s2;
            accessible-role: AccessibleRole.text;
            accessible-label: root.op.fate-word;
            Text {
                text: root.op.fate-sym;
                color: Theme.muted;
                font-family: Theme.font-symbol;
                font-size: Theme.fs-s;
                accessible-role: none;
            }

            Text {
                horizontal-stretch: 1;
                text: root.op.fate-word;
                color: Theme.strong;
                font-size: Theme.fs-s;
                font-weight: 500;
                wrap: word-wrap;
                accessible-role: none;
            }
        }
        if root.op.undo != "": Text {
            text: Str.lbl-undo + ": " + root.op.undo;
            color: Theme.muted;
            font-size: Theme.fs-s;
            wrap: word-wrap;
        }
    }
}

// The Steam launch option the user pastes: read-only text that can be selected and copied.
component LaunchBox inherits Rectangle {
    in property <LaunchData> l;
    in-out property <bool> copied;
    background: Theme.raised2;
    border-radius: Theme.radius-s;
    accessible-role: groupbox;
    accessible-label: root.l.heading;
    VerticalLayout {
        padding: Theme.s4;
        spacing: Theme.s2;
        Text {
            text: root.l.heading;
            color: Theme.strong;
            font-size: Theme.fs-m;
            font-weight: 600;
        }

        for line in root.l.lines: Muted {
            text: line;
        }
        if root.l.option != "": VerticalLayout {
            spacing: Theme.s2;
            Muted {
                text: root.l.intro;
            }

            HorizontalLayout {
                spacing: Theme.s3;
                option-field := LineEdit {
                    horizontal-stretch: 1;
                    read-only: true;
                    text: root.l.option;
                    font-size: Theme.fs-s + Theme.hair;
                    accessible-label: root.l.heading;
                }

                Button {
                    text: root.copied ? root.l.copied : root.l.copy;
                    activated => {
                        option-field.select-all();
                        option-field.copy();
                        root.copied = true;
                    }
                }
            }
        }
        for p in root.l.problems: WarnLine {
            w: p;
        }
        for n in root.l.notes: Text {
            text: n;
            color: Theme.muted;
            font-size: Theme.fs-s;
            wrap: word-wrap;
        }
    }
}

// The preview of the picked fixes (rule 5): every change before any change.
component PreviewPanel inherits VerticalLayout {
    in property <PreviewData> p;
    callback apply(string);
    spacing: Theme.s3;
    GroupHeading {
        text: Str.preview-title;
    }

    if root.p.state == 0: Muted {
        text: Str.preview-none;
    }
    if root.p.state == 1: Muted {
        text: Str.preview-planning;
    }
    if root.p.state == 3: NoticeCard {
        n: root.p.refused;
    }
    if root.p.state == 2: VerticalLayout {
        spacing: Theme.s3;
        Muted {
            text: Str.preview-intro;
        }

        HorizontalLayout {
            spacing: Theme.s6;
            alignment: start;
            VerticalLayout {
                spacing: Theme.hair * 2;
                accessible-role: AccessibleRole.text;
                accessible-label: root.p.summary;
                Text {
                    text: root.p.summary;
                    color: Theme.strong;
                    font-size: Theme.fs-m;
                    font-weight: 600;
                    accessible-role: none;
                }
            }

            if root.p.folder != "": VerticalLayout {
                spacing: Theme.hair * 2;
                accessible-role: AccessibleRole.text;
                accessible-label: Str.preview-folder;
                accessible-value: root.p.folder;
                Text {
                    text: Str.preview-folder;
                    color: Theme.muted;
                    font-size: Theme.fs-s;
                    accessible-role: none;
                }

                Text {
                    text: root.p.folder;
                    color: Theme.text;
                    font-family: Theme.font-mono;
                    font-size: Theme.fs-s + Theme.hair;
                    accessible-role: none;
                }
            }
            VerticalLayout {
                spacing: Theme.hair * 2;
                accessible-role: AccessibleRole.text;
                accessible-label: Str.preview-checksum;
                accessible-value: root.p.hash;
                Text {
                    text: Str.preview-checksum;
                    color: Theme.muted;
                    font-size: Theme.fs-s;
                    accessible-role: none;
                }

                Text {
                    text: root.p.hash;
                    color: Theme.text;
                    font-family: Theme.font-mono;
                    font-size: Theme.fs-xs;
                    accessible-role: none;
                }
            }
        }

        if root.p.nothing != "": Muted {
            text: root.p.nothing;
        }
        for op in root.p.ops: OpItem {
            op: op;
        }
        for w in root.p.warnings: WarnLine {
            w: w;
        }
        if root.p.has-launch: LaunchBox {
            l: root.p.launch;
        }
        for n in root.p.notes: Text {
            text: n;
            color: Theme.muted;
            font-size: Theme.fs-s;
            wrap: word-wrap;
        }
        Muted {
            text: root.p.admin;
        }

        Muted {
            text: root.p.undo;
        }

        HorizontalLayout {
            spacing: Theme.s4;
            alignment: start;
            Button {
                primary: true;
                text: Str.btn-apply;
                enabled: root.p.can-apply && root.p.ready && !Modal.working && !Modal.open;
                activated => {
                    root.apply(root.p.hash);
                }
            }

            Text {
                text: Modal.working ? Str.preview-applying : Str.preview-close-game;
                color: Theme.muted;
                font-size: Theme.fs-m;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}

// One transaction: everything in it, and what undo takes back together (user decision U1).
component CardView inherits Card {
    in property <CardData> c;
    in property <int> index;
    callback undo();
    callback forget();
    accessible-role: groupbox;
    accessible-label: root.c.game != "" ? root.c.game : root.c.id;
    accessible-description: root.c.state.word;
    VerticalLayout {
        padding: Theme.s5;
        spacing: Theme.s3;
        HorizontalLayout {
            spacing: Theme.s3;
            if root.c.game != "": Text {
                horizontal-stretch: 1;
                text: root.c.game;
                color: Theme.strong;
                font-size: Theme.fs-l;
                font-weight: 600;
                wrap: word-wrap;
                vertical-alignment: center;
            }
            if root.c.game == "": Rectangle {
                horizontal-stretch: 1;
            }
            Badge {
                data: root.c.state;
                accessible-role: none;
            }
        }

        HorizontalLayout {
            spacing: Theme.s2;
            Text {
                text: Str.card-txn;
                color: Theme.muted;
                font-size: Theme.fs-s;
            }

            Text {
                text: root.c.id;
                color: Theme.muted;
                font-family: Theme.font-mono;
                font-size: Theme.fs-s;
            }
        }

        if root.c.problem != "": Text {
            text: root.c.problem;
            color: Theme.text;
            font-size: Theme.fs-m;
            wrap: word-wrap;
        }
        for op in root.c.ops: OpItem {
            op: op;
        }
        Muted {
            text: root.c.note;
        }

        HorizontalLayout {
            spacing: Theme.s3;
            alignment: start;
            if root.c.can-undo: Button {
                text: Str.btn-undo;
                accessible-label: Str.btn-undo + ": " + (root.c.game != "" ? root.c.game : root.c.id);
                take-focus: Modal.return-to == root.index * 2;
                enabled: !Modal.open && !Modal.working;
                activated => {
                    root.undo();
                }
            }
            if root.c.can-forget: Button {
                text: Str.btn-forget;
                accessible-label: Str.btn-forget + ": " + (root.c.game != "" ? root.c.game : root.c.id);
                take-focus: Modal.return-to == root.index * 2 + 1;
                enabled: !Modal.open && !Modal.working;
                activated => {
                    root.forget();
                }
            }
        }
    }
}

// The outcome of an apply, an undo or a refusal: calm, with what to do. It takes the focus
// when it appears, so a screen reader reads it.
component BannerView inherits Rectangle {
    in property <BannerData> b;
    callback dismiss();
    background: Theme.raised;
    border-radius: Theme.radius-m;
    accessible-role: groupbox;
    accessible-label: root.b.title;
    Rectangle {
        x: 0;
        width: Theme.hair * 2;
        background: Theme.strong;
    }

    VerticalLayout {
        padding: Theme.s5;
        padding-left: Theme.s5 + Theme.hair * 2;
        spacing: Theme.s2;
        HorizontalLayout {
            spacing: Theme.s3;
            Text {
                text: root.b.sym;
                color: Theme.muted;
                font-family: Theme.font-symbol;
                font-size: Theme.fs-l;
                vertical-alignment: center;
                accessible-role: none;
            }

            PageTitle {
                horizontal-stretch: 1;
                text: root.b.title;
                size: Theme.fs-l;
                family: Theme.font-sans;
            }
        }

        Muted {
            text: root.b.body;
        }

        for d in root.b.details: DetailLine {
            d: d;
        }
        HorizontalLayout {
            alignment: start;
            Button {
                in-dialog: true;
                text: Str.btn-dismiss;
                activated => {
                    root.dismiss();
                }
            }
        }
    }
}

// The undo and forget dialogs: what the operation meets, before the click. Esc closes. While it
// is open `Modal.open` is set and only its controls can take the focus (a focus trap); the title
// takes the focus when it opens.
component DialogView inherits Rectangle {
    in property <DialogData> d;
    callback confirm();
    callback cancel();
    background: Theme.bg.with-alpha(0.85);
    // Keeps the mouse from reaching the page behind.
    TouchArea { }

    FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.cancel();
                return accept;
            }
            reject
        }
        VerticalLayout {
            alignment: center;
            padding: Theme.s6;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: min(root.width - Theme.s8, Theme.s8 * 14);
                    height: root.height - Theme.s8 * 2;
                    background: Theme.raised;
                    border-radius: Theme.radius-m;
                    border-width: Theme.hair;
                    border-color: Theme.line-strong;
                    accessible-role: groupbox;
                    accessible-label: root.d.title;
                    VerticalLayout {
                        padding: Theme.s6;
                        spacing: Theme.s4;
                        PageTitle {
                            text: root.d.title;
                            size: Theme.fs-l;
                            family: Theme.font-sans;
                        }

                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: Theme.s3;
                                if root.d.changed != "": Rectangle {
                                    background: Theme.raised2;
                                    border-radius: Theme.radius-s;
                                    accessible-role: AccessibleRole.text;
                                    accessible-label: root.d.changed;
                                    VerticalLayout {
                                        padding: Theme.s3;
                                        Text {
                                            text: root.d.changed;
                                            color: Theme.strong;
                                            font-size: Theme.fs-m;
                                            wrap: word-wrap;
                                            accessible-role: none;
                                        }
                                    }
                                }
                                Muted {
                                    text: root.d.intro;
                                }

                                for op in root.d.ops: OpItem {
                                    op: op;
                                }
                                for n in root.d.notes: Text {
                                    text: n;
                                    color: Theme.text;
                                    font-size: Theme.fs-m;
                                    wrap: word-wrap;
                                }
                                for x in root.d.details: DetailLine {
                                    d: x;
                                }
                                if root.d.has-launch: Rectangle {
                                    background: Theme.raised2;
                                    border-radius: Theme.radius-s;
                                    accessible-role: groupbox;
                                    accessible-label: root.d.launch-heading;
                                    VerticalLayout {
                                        padding: Theme.s4;
                                        spacing: Theme.s2;
                                        Text {
                                            text: root.d.launch-heading;
                                            color: Theme.strong;
                                            font-size: Theme.fs-m;
                                            font-weight: 600;
                                        }

                                        for line in root.d.launch-lines: Muted {
                                            text: line;
                                        }
                                        if root.d.launch-option != "": Text {
                                            text: root.d.launch-option;
                                            color: Theme.text;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.fs-s + Theme.hair;
                                            wrap: word-wrap;
                                        }
                                        for p in root.d.launch-problems: WarnLine {
                                            w: p;
                                        }
                                    }
                                }
                                if root.d.blocked != "": Text {
                                    text: root.d.blocked;
                                    color: Theme.strong;
                                    font-size: Theme.fs-m;
                                    font-weight: 600;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: Theme.s3;
                            alignment: end;
                            Button {
                                in-dialog: true;
                                text: Str.btn-cancel;
                                activated => {
                                    root.cancel();
                                }
                            }

                            Button {
                                in-dialog: true;
                                primary: true;
                                text: root.d.confirm;
                                enabled: root.d.can-confirm && !Modal.working;
                                activated => {
                                    root.confirm();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

component GamePage inherits VerticalLayout {
    in property <bool> loading;
    in property <GameData> game;
    in property <PreviewData> preview;
    callback back();
    callback fix-toggled(int);
    callback apply(string);
    callback card-undo(int);
    callback card-forget(int);
    spacing: Theme.s4;
    HorizontalLayout {
        alignment: start;
        back-button := Pressable {
            accessible-role: button;
            accessible-label: Str.back;
            accessible-action-default => {
                self.activated();
            }
            ring-inset: -3px;
            activated => {
                root.back();
            }
            HorizontalLayout {
                padding-top: Theme.s1;
                padding-bottom: Theme.s1;
                spacing: Theme.s1;
                Text {
                    text: "\u{2039} " + Str.back;
                    color: back-button.hovered ? Theme.strong : Theme.muted;
                    font-size: Theme.fs-m;
                    accessible-role: none;
                }
            }
        }
    }

    Text {
        text: Str.eyebrow;
        color: Theme.muted;
        font-size: Theme.fs-s;
    }

    PageTitle {
        text: root.game.title;
        size: Theme.fs-hero;
    }

    HorizontalLayout {
        spacing: Theme.s3;
        accessible-role: AccessibleRole.text;
        accessible-label: root.game.hero-line;
        accessible-description: root.game.hero-sub;
        Text {
            text: root.game.hero-sym;
            color: Theme.muted;
            font-family: Theme.font-symbol;
            font-size: Theme.fs-l + Theme.hair;
            accessible-role: none;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Theme.s1;
            Text {
                text: root.game.hero-line;
                color: Theme.strong;
                font-size: Theme.fs-l + Theme.hair;
                wrap: word-wrap;
                accessible-role: none;
            }

            if root.game.hero-sub != "": Text {
                text: root.game.hero-sub;
                color: Theme.muted;
                font-size: Theme.fs-m;
                wrap: word-wrap;
                accessible-role: none;
            }
        }
    }
    if root.game.detail != "": Text {
        text: root.game.detail;
        color: Theme.muted;
        font-family: Theme.font-mono;
        font-size: Theme.fs-s;
        wrap: word-wrap;
    }
    for note in root.game.notes: Rectangle {
        background: Theme.raised2;
        border-radius: Theme.radius-s;
        accessible-role: AccessibleRole.text;
        accessible-label: note;
        Rectangle {
            x: 0;
            width: Theme.hair * 2;
            background: Theme.line-strong;
        }

        VerticalLayout {
            padding: Theme.s3;
            padding-left: Theme.s4;
            Text {
                text: note;
                color: Theme.text;
                font-size: Theme.fs-m;
                wrap: word-wrap;
                accessible-role: none;
            }
        }
    }
    VerticalLayout {
        padding-top: Theme.s4;
        spacing: Theme.s4;
        Hairline {
            height: Theme.hair;
        }

        HorizontalLayout {
            spacing: Theme.s6;
            alignment: start;
            accessible-role: groupbox;
            accessible-label: Str.facts-label;
            for f in root.game.facts: VerticalLayout {
                spacing: Theme.hair * 2;
                accessible-role: AccessibleRole.text;
                accessible-label: f.label;
                accessible-value: f.value;
                Text {
                    text: f.label;
                    color: Theme.muted;
                    font-size: Theme.fs-s;
                    accessible-role: none;
                }

                Text {
                    text: f.value;
                    color: Theme.text;
                    font-size: f.mono ? Theme.fs-s + Theme.hair : Theme.fs-m;
                    font-family: f.mono ? Theme.font-mono : Theme.font-sans;
                    accessible-role: none;
                }
            }
        }
    }

    // The reading text holds the place of the problems and the fixes until they arrive.
    if root.loading: VerticalLayout {
        padding-top: Theme.s5;
        min-height: Theme.s8 * 3;
        accessible-role: AccessibleRole.text;
        accessible-label: Str.game-reading;
        Muted {
            text: Str.game-reading;
            accessible-role: none;
        }
    }
    if !root.loading && root.game.problems.length > 0: VerticalLayout {
        spacing: Theme.s3;
        padding-top: Theme.s5;
        GroupHeading {
            text: Str.problems-title;
        }

        Card {
            accessible-role: list;
            accessible-label: Str.problems-title;
            VerticalLayout {
                for p[i] in root.game.problems: Rectangle {
                    accessible-role: list-item;
                    accessible-label: p.title;
                    accessible-description: p.when.word;
                    accessible-item-index: i;
                    accessible-item-count: root.game.problems.length;
                    if i > 0: Hairline {
                        y: 0;
                        height: Theme.hair;
                    }
                    VerticalLayout {
                        padding: Theme.s5;
                        spacing: Theme.s2;
                        HorizontalLayout {
                            spacing: Theme.s4;
                            Text {
                                horizontal-stretch: 1;
                                text: p.title;
                                color: p.quiet ? Theme.muted : Theme.strong;
                                font-size: Theme.fs-l;
                                font-weight: 600;
                                wrap: word-wrap;
                                accessible-role: none;
                            }

                            VerticalLayout {
                                alignment: start;
                                Badge {
                                    data: p.when;
                                    accessible-role: none;
                                }
                            }
                        }

                        if !p.quiet && p.fixes.length == 0: Text {
                            text: Str.problem-no-fix;
                            color: Theme.muted;
                            font-size: Theme.fs-m;
                            accessible-role: none;
                        }
                        if !p.quiet && p.fixes.length > 0: HorizontalLayout {
                            spacing: Theme.s2;
                            alignment: start;
                            Text {
                                text: Str.problem-fixes;
                                color: Theme.muted;
                                font-size: Theme.fs-m;
                                accessible-role: none;
                            }

                            for fx in p.fixes: Text {
                                text: fx;
                                color: Theme.text;
                                font-family: Theme.font-mono;
                                font-size: Theme.fs-s + Theme.hair;
                                vertical-alignment: center;
                                accessible-role: none;
                            }
                        }
                    }
                }
            }
        }
    }

    if !root.loading && root.game.fixes.length > 0: VerticalLayout {
        spacing: Theme.s3;
        padding-top: Theme.s5;
        GroupHeading {
            text: Str.fixes-title;
        }

        Muted {
            text: Str.fixes-intro;
        }

        Muted {
            text: Str.fixes-read-only;
        }

        for fx[fi] in root.game.fixes: Card {
            accessible-role: groupbox;
            accessible-label: fx.id;
            accessible-description: fx.kind + ", " + fx.state.word;
            VerticalLayout {
                padding: Theme.s5;
                spacing: Theme.s3;
                HorizontalLayout {
                    spacing: Theme.s3;
                    Text {
                        text: fx.id;
                        color: Theme.strong;
                        font-family: Theme.font-mono;
                        font-size: Theme.fs-l;
                        font-weight: 600;
                        vertical-alignment: center;
                        accessible-role: none;
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: fx.kind;
                        color: Theme.muted;
                        font-size: Theme.fs-m;
                        vertical-alignment: center;
                        accessible-role: none;
                    }

                    Badge {
                        data: fx.state;
                        accessible-role: none;
                    }
                }

                if fx.selectable: Check {
                    text: Str.fix-select;
                    a11y: Str.fix-select + ": " + fx.id;
                    checked: fx.selected;
                    activated => {
                        root.fix-toggled(fi);
                    }
                }
                if fx.note != "": Text {
                    text: fx.note;
                    color: Theme.text;
                    font-size: Theme.fs-m;
                    wrap: word-wrap;
                }
                if fx.preselect-note != "": Text {
                    text: fx.preselect-note;
                    color: Theme.muted;
                    font-size: Theme.fs-s;
                    wrap: word-wrap;
                }
                if fx.exclusive.length > 0: HorizontalLayout {
                    spacing: Theme.s2;
                    alignment: start;
                    Text {
                        text: Str.fix-exclusive;
                        color: Theme.muted;
                        font-size: Theme.fs-s;
                    }

                    for e in fx.exclusive: Text {
                        text: e;
                        color: Theme.text;
                        font-family: Theme.font-mono;
                        font-size: Theme.fs-s;
                    }
                }
                if fx.refused != "": Text {
                    text: fx.refused;
                    color: Theme.text;
                    font-size: Theme.fs-m;
                    wrap: word-wrap;
                }
                if fx.refused-detail != "": Text {
                    text: fx.refused-detail;
                    color: Theme.muted;
                    font-family: Theme.font-mono;
                    font-size: Theme.fs-s;
                    wrap: word-wrap;
                }
                if fx.warned != "": Text {
                    text: fx.warned;
                    color: Theme.text;
                    font-size: Theme.fs-m;
                    wrap: word-wrap;
                }
                Text {
                    text: Str.fix-solves;
                    color: Theme.muted;
                    font-size: Theme.fs-s;
                    accessible-role: none;
                }

                for s in fx.solves: VerticalLayout {
                    spacing: Theme.s1;
                    HorizontalLayout {
                        spacing: Theme.s3;
                        accessible-role: AccessibleRole.text;
                        accessible-label: s.issue;
                        accessible-description: s.when.word + ", " + s.status.word;
                        Text {
                            horizontal-stretch: 1;
                            text: s.issue;
                            color: Theme.text;
                            font-size: Theme.fs-m;
                            wrap: word-wrap;
                            vertical-alignment: center;
                            accessible-role: none;
                        }

                        Badge {
                            data: s.when;
                            accessible-role: none;
                        }

                        Badge {
                            data: s.status;
                            accessible-role: none;
                        }
                    }

                    if s.tradeoffs.length == 0: Text {
                        text: Str.fix-no-tradeoffs;
                        color: Theme.muted;
                        font-size: Theme.fs-s;
                    }
                    if s.tradeoffs.length > 0: Text {
                        text: Str.fix-tradeoffs;
                        color: Theme.muted;
                        font-size: Theme.fs-s;
                    }
                    for tx in s.tradeoffs: Text {
                        text: tx;
                        color: Theme.text;
                        font-size: Theme.fs-s + Theme.hair;
                        wrap: word-wrap;
                    }
                    if s.sources.length > 0: Text {
                        text: Str.fix-sources;
                        color: Theme.muted;
                        font-size: Theme.fs-s;
                    }
                    for src in s.sources: Text {
                        text: src;
                        color: Theme.text;
                        font-family: Theme.font-mono;
                        font-size: Theme.fs-s;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }

    // The preview is mandatory before any apply (rule 5).
    if !root.loading && root.game.fixes.length > 0: PreviewPanel {
        p: root.preview;
        apply(h) => {
            root.apply(h);
        }
    }
    if !root.loading && root.game.applied.length > 0: VerticalLayout {
        spacing: Theme.s3;
        padding-top: Theme.s5;
        GroupHeading {
            text: Str.applied-here;
        }

        for c[ci] in root.game.applied: CardView {
            c: c;
            index: ci;
            undo => {
                root.card-undo(ci);
            }
            forget => {
                root.card-forget(ci);
            }
        }
    }
}

component AppliedPage inherits VerticalLayout {
    in property <AppliedData> applied;
    callback card-undo(int);
    callback card-forget(int);
    spacing: Theme.s4;
    PageTitle {
        text: Str.applied-title;
    }

    Muted {
        text: Str.applied-intro;
    }

    Card {
        accessible-role: AccessibleRole.text;
        accessible-label: root.applied.title;
        accessible-description: root.applied.sub;
        HorizontalLayout {
            padding: Theme.s5;
            spacing: Theme.s4;
            Text {
                text: root.applied.sym;
                color: Theme.muted;
                font-family: Theme.font-symbol;
                font-size: Theme.fs-l;
                accessible-role: none;
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.s1;
                Text {
                    text: root.applied.title;
                    color: Theme.strong;
                    font-size: Theme.fs-l;
                    font-weight: 600;
                    wrap: word-wrap;
                    accessible-role: none;
                }

                if root.applied.sub != "": Text {
                    text: root.applied.sub;
                    color: Theme.muted;
                    font-size: Theme.fs-m;
                    wrap: word-wrap;
                    accessible-role: none;
                }
                if root.applied.detail != "": Text {
                    text: root.applied.detail;
                    color: Theme.muted;
                    font-family: Theme.font-mono;
                    font-size: Theme.fs-s;
                    wrap: word-wrap;
                }
            }
        }
    }

    for c[ci] in root.applied.cards: CardView {
        c: c;
        index: ci;
        undo => {
            root.card-undo(ci);
        }
        forget => {
            root.card-forget(ci);
        }
    }
}

component HistoryPage inherits VerticalLayout {
    spacing: Theme.s4;
    PageTitle {
        text: Str.history-title;
    }

    Muted {
        text: Str.history-intro;
    }

    Card {
        VerticalLayout {
            padding: Theme.s5;
            Muted {
                text: Str.history-later;
            }
        }
    }
}

component SystemPage inherits VerticalLayout {
    in property <bool> loading;
    in property <[SysLineData]> lines;
    spacing: Theme.s4;
    PageTitle {
        text: Str.system-title;
    }

    Muted {
        text: root.loading ? Str.system-reading : Str.system-intro;
    }

    if !root.loading: Card {
        VerticalLayout {
            for l[i] in root.lines: Rectangle {
                accessible-role: AccessibleRole.text;
                accessible-label: l.label;
                if i > 0: Hairline {
                    y: 0;
                    height: Theme.hair;
                }
                HorizontalLayout {
                    padding: Theme.s5;
                    spacing: Theme.s4;
                    Text {
                        width: Theme.s8 * 3;
                        text: l.label;
                        color: Theme.muted;
                        font-size: Theme.fs-m;
                        accessible-role: none;
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Theme.s1;
                        for v in l.values: Text {
                            text: v;
                            color: Theme.text;
                            font-size: Theme.fs-m;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}

component SettingsPage inherits VerticalLayout {
    spacing: Theme.s4;
    PageTitle {
        text: Str.settings-title;
    }

    Muted {
        text: Str.settings-intro;
    }

    GroupHeading {
        text: Str.settings-safety;
    }

    Card {
        VerticalLayout {
            Setting {
                first: true;
                title: Str.set-preview;
                desc: Str.set-preview-desc;
                value: Str.always-on;
            }

            Setting {
                title: Str.set-sources;
                desc: Str.set-sources-desc;
                value: Str.always-on;
            }
        }
    }

    GroupHeading {
        text: Str.settings-look;
    }

    Card {
        VerticalLayout {
            Setting {
                first: true;
                title: Str.set-theme;
                value: Str.theme-name;
            }

            Setting {
                title: Str.set-language;
                value: Str.language-name;
            }
        }
    }

    GroupHeading {
        text: Str.settings-about;
    }

    Card {
        VerticalLayout {
            Setting {
                first: true;
                title: Str.about-version;
                desc: Str.about-licence;
            }
        }
    }
}

component BlockedPage inherits Rectangle {
    in property <NoticeData> n;
    background: Theme.bg;
    VerticalLayout {
        alignment: center;
        padding: Theme.s8;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                max-width: Theme.s8 * 11;
                spacing: Theme.s4;
                PageTitle {
                    text: root.n.title;
                }

                Muted {
                    text: root.n.body;
                    font-size: Theme.fs-l;
                }

                for d in root.n.details: DetailLine {
                    d: d;
                }
            }
        }
    }
}

// ---------------------------------------------------------------- the window

export component AppWindow inherits Window {
    no-frame: true;
    resize-border-width: Theme.resize-border;
    preferred-width: 1200px;
    preferred-height: 800px;
    min-width: 860px;
    min-height: 560px;
    background: Theme.bg;
    title: Str.app-name;
    default-font-family: Theme.font-sans;
    default-font-size: Theme.fs-m;
    icon: @image-url("../assets/rerun-icon.svg");

    // 0 library, 1 applied, 2 history, 3 system, 4 settings; the game page is on 0.
    in-out property <int> page: 0;
    in-out property <bool> game-open: false;
    in property <bool> max-nc-hover;
    in property <bool> blocked;
    in property <NoticeData> blocked-notice;
    in property <string> status-index;
    in property <string> status-signature;
    in property <string> status-build;
    in property <string> nav-library-count;
    in property <string> nav-applied-count;
    // Library.
    in property <bool> library-reading: true;
    in property <string> library-summary;
    in property <[NoticeData]> library-notices;
    in property <[SectionData]> sections;
    in property <int> shown-rows;
    in property <string> list-label;
    in-out property <string> query;
    in-out property <bool> group: true;
    in-out property <bool> first-run: true;
    // Game page.
    in property <bool> game-loading;
    in property <GameData> game;
    // Applied and system.
    in property <AppliedData> applied;
    in property <bool> system-loading: true;
    in property <[SysLineData]> system-lines;
    // Selecting, previewing, applying, undoing (P5-5a).
    in property <PreviewData> preview;
    in property <bool> banner-shown;
    in property <BannerData> banner;
    in property <bool> dialog-open;
    in property <DialogData> dialog;

    callback fix-toggled(int);
    callback apply(string);
    callback card-undo(int);
    callback card-forget(int);
    callback dialog-confirm();
    callback dialog-cancel();
    callback banner-dismiss();
    callback request-close();
    callback navigate(int);
    callback open-game(int);
    callback query-edited(string);
    callback group-toggled(bool);
    callback rescan();
    callback poll();

    // `Reveal.request`, routed back by `ui` (a global's callback is set from Rust).
    public function reveal(y: length, h: length) {
        if (!root.blocked) {
            scroller.reveal(y, h);
        }
    }
    changed page => {
        scroller.content-y = 0;
    }
    changed game-open => {
        scroller.content-y = 0;
    }

    VerticalLayout {
        // ---------- title bar
        Rectangle {
            height: Theme.title-h;
            background: Theme.bg;
            accessible-role: window-title-bar;
            accessible-label: Str.app-name;
            WindowMoveArea {
                TouchArea {
                    double-clicked => {
                        root.maximized = !root.maximized;
                    }
                }

                HorizontalLayout {
                    padding-left: Theme.s4 + Theme.hair * 2;
                    spacing: Theme.s4;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../assets/rerun-lockup-schnee.svg");
                            height: Theme.s4;
                            width: self.height * 425.27 / 70;
                            accessible-role: image;
                            accessible-label: Str.app-name;
                        }
                    }

                    Text {
                        text: Str.by;
                        font-family: Theme.font-mono;
                        font-size: Theme.fs-xs;
                        color: Theme.muted;
                        vertical-alignment: center;
                        accessible-role: none;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    // The three window buttons stay the last elements of the title bar, in this
                    // order: `ui::chrome` hit-tests the second from the right as the maximise
                    // button (source rule `the_caption_buttons_keep_their_order`).
                    CaptionButton {
                        glyph: "\u{E921}";
                        label: Str.minimize;
                        activated => {
                            root.minimized = true;
                        }
                    }

                    CaptionButton {
                        glyph: root.maximized ? "\u{E923}" : "\u{E922}";
                        label: root.maximized ? Str.restore : Str.maximize;
                        nc-hover: root.max-nc-hover;
                        activated => {
                            root.maximized = !root.maximized;
                        }
                    }

                    CaptionButton {
                        glyph: "\u{E8BB}";
                        label: Str.close;
                        danger: true;
                        activated => {
                            root.request-close();
                        }
                    }
                }
            }
        }

        Hairline {
            height: Theme.hair;
        }

        Rectangle {
            vertical-stretch: 1;
            Rectangle {
                visible: !root.blocked;
                HorizontalLayout {
                    // ---------- navigation
                    Rectangle {
                        width: Theme.nav-w;
                        accessible-role: tab-list;
                        accessible-label: Str.nav-label;
                        VerticalLayout {
                            padding: Theme.s4;
                            spacing: Theme.s1;
                            alignment: start;
                            Text {
                                text: Str.app-name;
                                color: Theme.muted;
                                font-family: Theme.font-mono;
                                font-size: Theme.fs-s;
                                accessible-role: none;
                            }

                            Rectangle {
                                height: Theme.s3;
                            }

                            for label[i] in Str.nav: NavItem {
                                sym: i == 0 ? "\u{25A4}" : i == 1 ? "\u{25A0}" : i == 2 ? "\u{21BA}" : i == 3 ? "\u{25A3}" : "\u{2699}";
                                text: label;
                                count: i == 0 ? root.nav-library-count : i == 1 ? root.nav-applied-count : "";
                                active: root.page == i;
                                accessible-item-index: i;
                                accessible-item-count: Str.nav.length;
                                activated => {
                                    root.navigate(i);
                                }
                            }
                        }
                    }

                    Rectangle {
                        width: Theme.hair;
                        background: Theme.line-soft;
                    }

                    // ---------- the page
                    scroller := ScrollView {
                        horizontal-stretch: 1;
                        accessible-role: main;
                        accessible-label: root.page == 0 ? (root.game-open ? root.game.title : Str.library-title) : root.page == 1 ? Str.applied-title : root.page == 2 ? Str.history-title : root.page == 3 ? Str.system-title : Str.settings-title;
                        function reveal(y: length, h: length) {
                            let top = y - self.absolute-position.y;
                            if (top < 0) {
                                self.content-y = min(0px, self.content-y - top);
                            } else if (top + h > self.visible-height) {
                                self.content-y = self.content-y - (top + h - self.visible-height);
                            }
                        }
                        HorizontalLayout {
                            padding-left: Theme.s8;
                            padding-right: Theme.s8;
                            padding-top: Theme.s7;
                            padding-bottom: Theme.s8;
                            VerticalLayout {
                                max-width: Theme.s8 * 16;
                                horizontal-stretch: 1;
                                alignment: start;
                                spacing: Theme.s4;
                                if root.banner-shown: BannerView {
                                    b: root.banner;
                                    dismiss => {
                                        root.banner-dismiss();
                                    }
                                }
                                if root.page == 0 && !root.game-open: LibraryPage {
                                    reading: root.library-reading;
                                    summary: root.library-summary;
                                    notices: root.library-notices;
                                    sections: root.sections;
                                    shown: root.shown-rows;
                                    list-label: root.list-label;
                                    query <=> root.query;
                                    group <=> root.group;
                                    first-run <=> root.first-run;
                                    query-edited(t) => {
                                        root.query-edited(t);
                                    }
                                    group-toggled(v) => {
                                        root.group-toggled(v);
                                    }
                                    open-game(id) => {
                                        root.open-game(id);
                                    }
                                    rescan => {
                                        root.rescan();
                                    }
                                }
                                if root.page == 0 && root.game-open: GamePage {
                                    loading: root.game-loading;
                                    game: root.game;
                                    preview: root.preview;
                                    back => {
                                        root.navigate(0);
                                    }
                                    fix-toggled(i) => {
                                        root.fix-toggled(i);
                                    }
                                    apply(h) => {
                                        root.apply(h);
                                    }
                                    card-undo(i) => {
                                        root.card-undo(i);
                                    }
                                    card-forget(i) => {
                                        root.card-forget(i);
                                    }
                                }
                                if root.page == 1: AppliedPage {
                                    applied: root.applied;
                                    card-undo(i) => {
                                        root.card-undo(i);
                                    }
                                    card-forget(i) => {
                                        root.card-forget(i);
                                    }
                                }
                                if root.page == 2: HistoryPage { }
                                if root.page == 3: SystemPage {
                                    loading: root.system-loading;
                                    lines: root.system-lines;
                                }
                                if root.page == 4: SettingsPage { }
                            }
                        }
                    }
                }

            }
            if root.blocked: BlockedPage {
                width: 100%;
                height: 100%;
                n: root.blocked-notice;
            }
            if root.dialog-open && !root.blocked: DialogView {
                width: 100%;
                height: 100%;
                d: root.dialog;
                confirm => {
                    root.dialog-confirm();
                }
                cancel => {
                    root.dialog-cancel();
                }
            }
        }

        Hairline {
            height: Theme.hair;
        }

        // ---------- status bar
        Rectangle {
            height: Theme.s5 + Theme.s1;
            accessible-role: content-info;
            HorizontalLayout {
                padding-left: Theme.s4 + Theme.hair * 2;
                padding-right: Theme.s4 + Theme.hair * 2;
                spacing: Theme.s4;
                for part in [Str.no-background, root.status-index, root.status-signature, root.status-build, Modal.working ? Str.working : ""]: Text {
                    visible: part != "";
                    text: part;
                    font-family: Theme.font-mono;
                    font-size: Theme.fs-xs;
                    color: Theme.faint;
                    vertical-alignment: center;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
        }
    }
}
