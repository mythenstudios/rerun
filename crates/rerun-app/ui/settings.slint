// Settings (docs/07-ui.md): safety, packages (P5-8b-3), data (P5-10a), appearance (P5-10c) and
// about. Only `rerun-app::ui` and `build.rs` know this file (ADR 0026); `app.slint` places the
// page. Every colour comes from `Theme`, every string from `Str` or a view model.

import { Pressable, PageTitle, Badge, Button, PartsLine, Hairline, Muted, GroupHeading, Card, StoreData, StoreRowData, DataFolderData, Theme, Str, Modal } from "base.slint";

component Setting inherits Rectangle {
    in property <string> title;
    in property <string> desc;
    in property <string> value;
    in property <bool> first;
    accessible-role: AccessibleRole.text;
    accessible-label: root.title + ", " + root.value;
    accessible-description: root.desc;
    if !root.first: Hairline {
        y: 0;
        height: Theme.hair;
    }
    HorizontalLayout {
        padding: Theme.s5;
        spacing: Theme.s4;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Theme.s1;
            Text {
                text: root.title;
                color: Theme.strong;
                font-size: Theme.fs-l;
                font-weight: 600;
                wrap: word-wrap;
                accessible-role: none;
            }

            if root.desc != "": Text {
                text: root.desc;
                color: Theme.muted;
                font-size: Theme.fs-m;
                wrap: word-wrap;
                accessible-role: none;
            }
        }

        Text {
            text: root.value;
            color: Theme.text;
            font-size: Theme.fs-m;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}


// One choice of a radio group: the ring and its dot, the name. A click or Space picks it; the
// screen reader reads a radio button with its checked state.
component RadioChoice inherits Pressable {
    in property <string> text;
    in property <bool> checked;
    ring-inset: -3px;
    accessible-role: radio-button;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-label: root.text;
    accessible-action-default => {
        if (root.enabled) {
            root.activated();
        }
    }
    HorizontalLayout {
        spacing: Theme.s2;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: Theme.s4;
                height: Theme.s4;
                border-radius: self.width / 2;
                border-width: Theme.hair * 2;
                border-color: root.enabled ? Theme.strong : Theme.faint;
                Rectangle {
                    visible: root.checked;
                    width: parent.width / 2;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: root.enabled ? Theme.strong : Theme.faint;
                }
            }
        }

        Text {
            text: root.text;
            color: root.enabled ? Theme.text : Theme.faint;
            font-size: Theme.fs-m;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

// Settings > Appearance > Theme (P5-10c): Mythen or Nacht, applied at once. While Windows' high
// contrast is on, its colours win: the choice is off and a sentence says why.
component ThemeSetting inherits Rectangle {
    in property <int> choice;
    in property <bool> high-contrast;
    callback chosen(int);
    HorizontalLayout {
        padding: Theme.s5;
        spacing: Theme.s4;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Theme.s1;
            Text {
                text: Str.set-theme;
                color: Theme.strong;
                font-size: Theme.fs-l;
                font-weight: 600;
                wrap: word-wrap;
                accessible-role: none;
            }

            Text {
                text: root.high-contrast ? Str.theme-hc : Str.set-theme-desc;
                color: Theme.muted;
                font-size: Theme.fs-m;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            accessible-role: radio-group;
            accessible-label: Str.set-theme;
            accessible-description: root.high-contrast ? Str.theme-hc : "";
            spacing: Theme.s2;
            for name[i] in Str.theme-names: RadioChoice {
                text: name;
                checked: i == root.choice;
                enabled: !root.high-contrast && !Modal.open;
                activated => {
                    root.chosen(i);
                }
            }
        }
    }
}

// One package of the store: what it is, how big, who uses it, and the button that opens the
// removal dialog (a package a change uses cannot be removed: the button is off and the reason
// stands under it).
component PackageRow inherits Card {
    in property <StoreRowData> r;
    in property <int> index;
    callback remove();
    accessible-role: groupbox;
    accessible-label: root.r.title + " " + root.r.ident;
    accessible-description: root.r.state.word;
    VerticalLayout {
        padding: Theme.s5;
        spacing: Theme.s2;
        HorizontalLayout {
            spacing: Theme.s3;
            Text {
                horizontal-stretch: 1;
                text: root.r.title;
                color: Theme.strong;
                font-size: Theme.fs-l;
                font-weight: 600;
                wrap: word-wrap;
                vertical-alignment: center;
            }

            Badge {
                data: root.r.state;
                accessible-role: none;
            }
        }

        Text {
            text: root.r.ident;
            color: Theme.muted;
            font-family: Theme.font-mono;
            font-size: Theme.fs-s;
            wrap: word-wrap;
        }

        if root.r.note != "": Text {
            text: root.r.note;
            color: Theme.strong;
            font-size: Theme.fs-m;
            wrap: word-wrap;
        }
        Text {
            text: root.r.facts;
            color: Theme.text;
            font-size: Theme.fs-m;
            wrap: word-wrap;
        }

        for u in root.r.used: PartsLine {
            p: u;
            tone: Theme.muted;
            size: Theme.fs-m;
        }
        if root.r.keep != "": Text {
            text: root.r.keep;
            color: Theme.strong;
            font-size: Theme.fs-m;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: start;
            padding-top: Theme.s2;
            Button {
                text: root.r.remove-label;
                accessible-label: root.r.remove-label + ": " + root.r.title + " " + root.r.ident;
                take-focus: Modal.return-to == -10000 - root.index;
                enabled: root.r.can-remove && !Modal.open && !Modal.working;
                activated => {
                    root.remove();
                }
            }
        }
    }
}

// Settings > Packages: Rerun's package store, read each time the page opens.
component PackagesGroup inherits VerticalLayout {
    in property <StoreData> store;
    callback remove(int);
    callback remove-all();
    spacing: Theme.s3;
    GroupHeading {
        text: Str.settings-packages;
    }

    Muted {
        text: Str.settings-packages-intro;
    }

    if root.store.empty-title != "": Card {
        accessible-role: AccessibleRole.text;
        accessible-label: root.store.empty-title;
        accessible-description: root.store.empty-sub;
        VerticalLayout {
            padding: Theme.s5;
            spacing: Theme.s1;
            Text {
                text: root.store.empty-title;
                color: Theme.strong;
                font-size: Theme.fs-l;
                font-weight: 600;
                wrap: word-wrap;
                accessible-role: none;
            }

            if root.store.empty-sub != "": Text {
                text: root.store.empty-sub;
                color: Theme.muted;
                font-size: Theme.fs-m;
                wrap: word-wrap;
                accessible-role: none;
            }
            if root.store.detail != "": Text {
                text: root.store.detail;
                color: Theme.muted;
                font-family: Theme.font-mono;
                font-size: Theme.fs-s;
                wrap: word-wrap;
            }
        }
    }
    if root.store.remove-all-label != "": HorizontalLayout {
        alignment: start;
        Button {
            text: root.store.remove-all-label;
            take-focus: Modal.return-to == -1001;
            enabled: root.store.can-remove-all && !Modal.open && !Modal.working;
            activated => {
                root.remove-all();
            }
        }
    }
    for r[ri] in root.store.rows: PackageRow {
        r: r;
        index: ri;
        remove => {
            root.remove(ri);
        }
    }
    for line in root.store.extra: Muted {
        text: line;
    }
    if root.store.foreign-heading != "": VerticalLayout {
        spacing: Theme.s1;
        Muted {
            text: root.store.foreign-heading;
        }

        for line in root.store.foreign: PartsLine {
            p: line;
            tone: Theme.muted;
            mono: true;
        }
    }
}

// Settings > Data: where Rerun's folder is, and "Open in Explorer" only while it exists
// (P5-10a; the folder is fixed, ADR 0027 U6 a).
component DataGroup inherits VerticalLayout {
    in property <DataFolderData> data;
    callback open();
    spacing: Theme.s3;
    GroupHeading {
        text: Str.settings-data;
    }

    Muted {
        text: Str.data-intro;
    }

    Card {
        VerticalLayout {
            padding: Theme.s5;
            spacing: Theme.s2;
            if root.data.path != "": Text {
                text: root.data.path;
                color: Theme.strong;
                font-family: Theme.font-mono;
                font-size: Theme.fs-m;
                wrap: word-wrap;
            }
            if root.data.note != "": Text {
                text: root.data.note;
                color: Theme.muted;
                font-size: Theme.fs-m;
                wrap: word-wrap;
            }
            if root.data.detail != "": Text {
                text: root.data.detail;
                color: Theme.muted;
                font-family: Theme.font-mono;
                font-size: Theme.fs-s;
                wrap: word-wrap;
            }
            if root.data.exists: HorizontalLayout {
                alignment: start;
                padding-top: Theme.s2;
                Button {
                    text: Str.data-open;
                    enabled: !Modal.open;
                    activated => {
                        root.open();
                    }
                }
            }
        }
    }
}

export component SettingsPage inherits VerticalLayout {
    in property <StoreData> store;
    in property <DataFolderData> data;
    // The theme chosen (0 Mythen, 1 Nacht) and whether Windows' high contrast overrides it.
    in property <int> theme-choice;
    in property <bool> high-contrast;
    callback store-remove(int);
    callback store-remove-all();
    callback open-data-folder();
    callback theme-chosen(int);
    spacing: Theme.s4;
    PageTitle {
        text: Str.settings-title;
    }

    Muted {
        text: Str.settings-intro;
    }

    GroupHeading {
        text: Str.settings-safety;
    }

    Card {
        VerticalLayout {
            Setting {
                first: true;
                title: Str.set-preview;
                desc: Str.set-preview-desc;
                value: Str.always-on;
            }

            Setting {
                title: Str.set-sources;
                desc: Str.set-sources-desc;
                value: Str.always-on;
            }
        }
    }

    PackagesGroup {
        store: root.store;
        remove(i) => {
            root.store-remove(i);
        }
        remove-all => {
            root.store-remove-all();
        }
    }

    DataGroup {
        data: root.data;
        open => {
            root.open-data-folder();
        }
    }

    GroupHeading {
        text: Str.settings-look;
    }

    Card {
        VerticalLayout {
            ThemeSetting {
                choice: root.theme-choice;
                high-contrast: root.high-contrast;
                chosen(i) => {
                    root.theme-chosen(i);
                }
            }

            Setting {
                title: Str.set-language;
                value: Str.language-name;
            }
        }
    }

    GroupHeading {
        text: Str.settings-about;
    }

    Card {
        VerticalLayout {
            Setting {
                first: true;
                title: Str.about-version;
                desc: Str.about-licence;
            }
        }
    }
}
