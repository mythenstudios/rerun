{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rerun:schema:topo:1",
  "title": "Rerun Topo v1",
  "description": "Game recipe. See docs/02-topo-format.md. Purely declarative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "title",
    "status",
    "rev",
    "match",
    "issues"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "rev": {
      "type": "integer",
      "minimum": 1
    },
    "tested_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "x64",
          "arm64"
        ]
      }
    },
    "match": {
      "$ref": "#/$defs/match"
    },
    "launch": {
      "$ref": "#/$defs/launch"
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "tips": {
      "$ref": "#/$defs/tips"
    },
    "links": {
      "$ref": "#/$defs/links"
    }
  },
  "$defs": {
    "id": {
      "description": "Lowercase letters, digits, hyphens.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "packageId": {
      "$ref": "#/$defs/id"
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "needs-retest",
        "retired"
      ]
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9A-F]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "sha1OrTodo": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha1"
        },
        {
          "const": "TODO"
        }
      ]
    },
    "sha256OrTodo": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "const": "TODO"
        }
      ]
    },
    "httpsUrl": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*\\.[a-z]{2,63}(/[^\\s\\\\]*)?$"
    },
    "repoUrl": {
      "type": "string",
      "pattern": "^https://(github\\.com|gitlab\\.com|codeberg\\.org)/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?$"
    },
    "relPath": {
      "description": "Relative path inside the game folder. Same rules as rerun_core::policy::path::RelPath (parity test: tests/fixtures/paths.json).",
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[^\\\\/<>:\"|?*\\x00-\\x1f\\x7f-\\x9f\\u00A0\\u00AD\\u061C\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB\\uE000-\\uF8FF\\uFF01-\\uFF5E\\u00A5\\u20A9\\u2215\\u2044\\u29F8]+([\\\\/][^\\\\/<>:\"|?*\\x00-\\x1f\\x7f-\\x9f\\u00A0\\u00AD\\u061C\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB\\uE000-\\uF8FF\\uFF01-\\uFF5E\\u00A5\\u20A9\\u2215\\u2044\\u29F8]+)*$",
      "not": {
        "anyOf": [
          {
            "description": ". or ..",
            "pattern": "(^|[\\\\/])\\.\\.?([\\\\/]|$)"
          },
          {
            "description": "dot/space at end of segment",
            "pattern": "[. ]([\\\\/]|$)"
          },
          {
            "description": "space at start of segment",
            "pattern": "(^|[\\\\/]) "
          },
          {
            "description": "8.3 short name",
            "pattern": "~[0-9]"
          },
          {
            "description": "reserved device name",
            "pattern": "(^|[\\\\/])([Cc][Oo][Nn]|[Cc][Oo][Nn][Ii][Nn]\\$|[Cc][Oo][Nn][Oo][Uu][Tt]\\$|[Cc][Ll][Oo][Cc][Kk]\\$|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9¹²³]|[Ll][Pp][Tt][0-9¹²³]) *(\\.[^\\\\/]*)?([\\\\/]|$)"
          }
        ]
      }
    },
    "dllName": {
      "description": "A DLL file name in the game folder; the relPath rules apply as well.",
      "allOf": [
        {
          "$ref": "#/$defs/relPath"
        }
      ],
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+\\.[Dd][Ll][Ll]$"
    },
    "api": {
      "enum": [
        "ddraw",
        "d3d8",
        "d3d9",
        "d3d10",
        "d3d11",
        "opengl"
      ]
    },
    "arch": {
      "enum": [
        "x86",
        "x64"
      ]
    },
    "archId": {
      "description": "GPU architecture identifier (ADR 0015): a lowercase letter, then up to 31 lowercase letters, digits or underscores; never \"unknown\" (a profile state, not a value).",
      "type": "string",
      "allOf": [
        {
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        },
        {
          "not": {
            "const": "unknown"
          }
        }
      ]
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exes"
      ],
      "properties": {
        "steam_appid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "exes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/exe"
          }
        }
      }
    },
    "exe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "api"
      ],
      "anyOf": [
        {
          "required": [
            "sha1"
          ]
        },
        {
          "required": [
            "sha256"
          ]
        }
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relPath"
        },
        "sha1": {
          "$ref": "#/$defs/sha1OrTodo"
        },
        "sha256": {
          "$ref": "#/$defs/sha256OrTodo"
        },
        "api": {
          "$ref": "#/$defs/api"
        }
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chain": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "steam",
              "upc",
              "ea-app",
              "rockstar",
              "battlenet",
              "epic",
              "gog-galaxy"
            ]
          }
        },
        "method": {
          "enum": [
            "auto",
            "direct",
            "watch",
            "hold",
            "ifeo",
            "inproc"
          ]
        },
        "fallback": {
          "enum": [
            "direct",
            "watch",
            "hold",
            "ifeo",
            "inproc"
          ]
        },
        "cpu": {
          "$ref": "#/$defs/cpuRuleLaunch"
        }
      },
      "if": {
        "required": [
          "method"
        ],
        "properties": {
          "method": {
            "const": "inproc"
          }
        }
      },
      "else": {
        "properties": {
          "cpu": {
            "not": {
              "required": [
                "report_cores"
              ]
            }
          }
        }
      }
    },
    "cpuRule": {
      "description": "CPU rule without report_cores (as a step). Never thread numbers.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "max_threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "prefer": {
          "enum": [
            "performance",
            "any"
          ]
        },
        "single_l3": {
          "type": "boolean"
        },
        "prefer_l3": {
          "enum": [
            "largest"
          ]
        },
        "smt": {
          "type": "boolean",
          "description": "false = only one thread per core."
        },
        "mode": {
          "enum": [
            "hard",
            "soft"
          ]
        }
      }
    },
    "cpuRuleLaunch": {
      "description": "CPU rule in launch.cpu; report_cores only with method: inproc.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "max_threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "prefer": {
          "enum": [
            "performance",
            "any"
          ]
        },
        "single_l3": {
          "type": "boolean"
        },
        "prefer_l3": {
          "enum": [
            "largest"
          ]
        },
        "smt": {
          "type": "boolean",
          "description": "false = only one thread per core."
        },
        "mode": {
          "enum": [
            "hard",
            "soft"
          ]
        },
        "report_cores": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "variants"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "when": {
          "$ref": "#/$defs/when"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "variants": {
          "description": "Empty = \"no known fix\" (a valid answer).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/variant"
          }
        }
      }
    },
    "when": {
      "description": "Conditions against the system profile; multiple fields = AND.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gpu.vendor": {
          "enum": [
            "amd",
            "nvidia",
            "intel"
          ]
        },
        "gpu.arch": {
          "description": "Identifiers declared in the paired GPU architecture table (data/gpu-arch.yaml, ADR 0015).",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/archId"
          }
        },
        "cpu.threads": {
          "$ref": "#/$defs/compare"
        },
        "cpu.hybrid": {
          "type": "boolean"
        },
        "os.build": {
          "$ref": "#/$defs/compare"
        }
      }
    },
    "compare": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "gt": {
          "type": "integer"
        },
        "gte": {
          "type": "integer"
        },
        "lt": {
          "type": "integer"
        },
        "lte": {
          "type": "integer"
        },
        "eq": {
          "type": "integer"
        }
      }
    },
    "check": {
      "description": "Hint only about a runtime outside the game folder; Rerun installs nothing.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime"
      ],
      "properties": {
        "runtime": {
          "enum": [
            "vcredist-x86",
            "vcredist-x64",
            "directx-jun2010"
          ]
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "kind",
        "steps"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "verified",
            "reported",
            "unverified"
          ]
        },
        "kind": {
          "enum": [
            "fix",
            "enhancement"
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "tradeoffs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "step": {
      "description": "Exactly one primitive. v1: only primitives with a defined spec.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "package": {
          "$ref": "#/$defs/packageId"
        },
        "steam_input": {
          "const": "enable"
        },
        "cpu": {
          "$ref": "#/$defs/cpuRule"
        },
        "registry_set": {
          "$ref": "#/$defs/registrySet"
        },
        "compat_layer": {
          "$ref": "#/$defs/compatLayer"
        },
        "ini_set": {
          "$ref": "#/$defs/iniSet"
        }
      }
    },
    "iniSet": {
      "description": "Keys of an existing INI file of the game folder (docs/02-topo-format.md, ADR 0021, ADR 0020 amendment P2-12). The schema checks the form; the rule for new values (none of \\ / : % ; # [ ], no ..), unique sections and keys, desktop.ini and the file itself are checked by the loader and the planner.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "values"
      ],
      "properties": {
        "file": {
          "allOf": [
            {
              "$ref": "#/$defs/relPath"
            },
            {
              "pattern": "\\.[Ii][Nn][Ii]$"
            }
          ]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/iniValue"
          }
        }
      }
    },
    "iniValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section",
        "key",
        "value"
      ],
      "properties": {
        "section": {
          "$ref": "#/$defs/iniName"
        },
        "key": {
          "$ref": "#/$defs/iniName"
        },
        "value": {
          "description": "1 to 128 printable ASCII characters, no space at either end.",
          "type": "string",
          "pattern": "^[\\x21-\\x7e]([\\x20-\\x7e]{0,126}[\\x21-\\x7e])?$"
        }
      }
    },
    "iniName": {
      "description": "A section or key name: A-Z a-z 0-9 _ . - and space, 1 to 64 characters, no space at either end.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]([A-Za-z0-9_. -]{0,62}[A-Za-z0-9_.-])?$"
    },
    "compatLayer": {
      "description": "Compatibility-layer tokens for an executable of the game folder in HKCU\\...\\AppCompatFlags\\Layers (docs/02-topo-format.md, ADR 0018 amendment P2-11). The schema checks the form; the token allowlist (docs/05-sources-policy.md, Reference data), the groups and the executable itself are checked by the loader and the planner.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exe",
        "layers"
      ],
      "properties": {
        "exe": {
          "allOf": [
            {
              "$ref": "#/$defs/relPath"
            },
            {
              "pattern": "\\.[Ee][Xx][Ee]$"
            }
          ]
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]{1,40}$"
          }
        }
      }
    },
    "registrySet": {
      "description": "Values below HKCU\\Software\\<Vendor>\\<Product>[\\...] (docs/02-topo-format.md, ADR 0018). The schema checks the form; the vendor deny list, unique names and the qword range are checked by the loader and the planner.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "values"
      ],
      "properties": {
        "key": {
          "description": "HKCU\\Software, then <Vendor>, <Product> and at most 4 more segments: 1 to 64 printable ASCII characters without a backslash or a space at either end.",
          "type": "string",
          "pattern": "^HKCU\\\\Software(\\\\[\\x21-\\x5b\\x5d-\\x7e]([\\x20-\\x5b\\x5d-\\x7e]{0,62}[\\x21-\\x5b\\x5d-\\x7e])?){2,6}$"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/registryValue"
          }
        }
      }
    },
    "registryValue": {
      "description": "A value name and exactly one of dword, qword (a decimal string), sz.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "description": "Printable ASCII without \\ / : % and without a space at either end; empty is the default value.",
          "type": "string",
          "maxLength": 128,
          "pattern": "^([\\x21-\\x24\\x26-\\x2e\\x30-\\x39\\x3b-\\x5b\\x5d-\\x7e]([\\x20-\\x24\\x26-\\x2e\\x30-\\x39\\x3b-\\x5b\\x5d-\\x7e]*[\\x21-\\x24\\x26-\\x2e\\x30-\\x39\\x3b-\\x5b\\x5d-\\x7e])?)?$"
        },
        "dword": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "qword": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "sz": {
          "description": "Printable ASCII without \\ / : % (no paths, no variables), at most 1,024 characters.",
          "type": "string",
          "maxLength": 1024,
          "pattern": "^[\\x20-\\x24\\x26-\\x2e\\x30-\\x39\\x3b-\\x5b\\x5d-\\x7e]*$"
        }
      },
      "oneOf": [
        {
          "required": [
            "dword"
          ]
        },
        {
          "required": [
            "qword"
          ]
        },
        {
          "required": [
            "sz"
          ]
        }
      ]
    },
    "source": {
      "description": "Direct link to a guide, thread, repo or section - never just the home page.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "url"
      ],
      "properties": {
        "type": {
          "enum": [
            "repo",
            "steam-guide",
            "steam-thread",
            "pcgw",
            "official"
          ]
        },
        "url": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "repo"
              }
            }
          },
          "then": {
            "properties": {
              "url": {
                "pattern": "^https://(github\\.com|gitlab\\.com|codeberg\\.org)/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(/[^\\s]*)?$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "steam-guide"
              }
            }
          },
          "then": {
            "properties": {
              "url": {
                "pattern": "^https://steamcommunity\\.com/sharedfiles/filedetails/\\?id=[0-9]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "steam-thread"
              }
            }
          },
          "then": {
            "properties": {
              "url": {
                "pattern": "^https://steamcommunity\\.com/(app/[0-9]+|groups/[A-Za-z0-9_-]+)/discussions/[0-9]+/[0-9]+/?$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "pcgw"
              }
            }
          },
          "then": {
            "properties": {
              "url": {
                "pattern": "^https://www\\.pcgamingwiki\\.com/wiki/[^\\s#]+(#[^\\s]+)?$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "official"
              }
            }
          },
          "then": {
            "properties": {
              "url": {
                "pattern": "^https://[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*\\.[a-z]{2,63}/[^\\s\\\\]+$"
              }
            }
          }
        }
      ]
    },
    "tips": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "launch_options": {
          "description": "Single game arguments that Rerun places after %command%. No commands, no %, no quotes.",
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[-+][A-Za-z0-9_.=+-]+$"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "$ref": "#/$defs/source"
              }
            }
          }
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pcgw": {
          "description": "PCGamingWiki page name, not a URL.",
          "type": "string",
          "pattern": "^[^\\s/?#]+$"
        }
      }
    }
  }
}
