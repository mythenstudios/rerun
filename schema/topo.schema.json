{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rerun:schema:topo:1",
  "title": "Rerun Topo v1",
  "description": "Game recipe. See docs/02-topo-format.md. Purely declarative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "id",
    "title",
    "status",
    "rev",
    "match",
    "issues"
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "anti_cheat"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "draft"
          }
        }
      }
    },
    {
      "description": "An ini_set with root user_data needs the Topo's user_data (P4-12).",
      "if": {
        "not": {
          "required": [
            "user_data"
          ]
        }
      },
      "then": {
        "properties": {
          "issues": {
            "items": {
              "properties": {
                "variants": {
                  "items": {
                    "properties": {
                      "steps": {
                        "items": {
                          "properties": {
                            "ini_set": {
                              "properties": {
                                "root": {
                                  "const": "game"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "rev": {
      "type": "integer",
      "minimum": 1
    },
    "tested_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "x64",
          "arm64"
        ]
      }
    },
    "match": {
      "$ref": "#/$defs/match"
    },
    "launch": {
      "$ref": "#/$defs/launch"
    },
    "anti_cheat": {
      "$ref": "#/$defs/antiCheatRelease"
    },
    "user_data": {
      "$ref": "#/$defs/userData"
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "tips": {
      "$ref": "#/$defs/tips"
    },
    "links": {
      "$ref": "#/$defs/links"
    }
  },
  "$defs": {
    "id": {
      "description": "Lowercase letters, digits, hyphens.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "packageId": {
      "$ref": "#/$defs/id"
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "needs-retest",
        "retired"
      ]
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9A-F]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "sha1OrTodo": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha1"
        },
        {
          "const": "TODO"
        }
      ]
    },
    "sha256OrTodo": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "const": "TODO"
        }
      ]
    },
    "httpsUrl": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*\\.[a-z]{2,63}(/[^\\s\\\\]*)?$"
    },
    "repoUrl": {
      "type": "string",
      "pattern": "^https://(github\\.com|gitlab\\.com|codeberg\\.org)/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?$"
    },
    "relPath": {
      "description": "Relative path inside the game folder. Same rules as rerun_core::policy::path::RelPath (parity test: tests/fixtures/paths.json).",
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[^\\\\/<>:\"|?*\\x00-\\x1f\\x7f-\\x9f\\u00A0\\u00AD\\u061C\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB\\uE000-\\uF8FF\\uFF01-\\uFF5E\\u00A5\\u20A9\\u2215\\u2044\\u29F8]+([\\\\/][^\\\\/<>:\"|?*\\x00-\\x1f\\x7f-\\x9f\\u00A0\\u00AD\\u061C\\u1680\\u180E\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u206F\\u3000\\uFEFF\\uFFF9-\\uFFFB\\uE000-\\uF8FF\\uFF01-\\uFF5E\\u00A5\\u20A9\\u2215\\u2044\\u29F8]+)*$",
      "not": {
        "anyOf": [
          {
            "description": ". or ..",
            "pattern": "(^|[\\\\/])\\.\\.?([\\\\/]|$)"
          },
          {
            "description": "dot/space at end of segment",
            "pattern": "[. ]([\\\\/]|$)"
          },
          {
            "description": "space at start of segment",
            "pattern": "(^|[\\\\/]) "
          },
          {
            "description": "8.3 short name",
            "pattern": "~[0-9]"
          },
          {
            "description": "reserved device name",
            "pattern": "(^|[\\\\/])([Cc][Oo][Nn]|[Cc][Oo][Nn][Ii][Nn]\\$|[Cc][Oo][Nn][Oo][Uu][Tt]\\$|[Cc][Ll][Oo][Cc][Kk]\\$|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9¹²³]|[Ll][Pp][Tt][0-9¹²³]) *(\\.[^\\\\/]*)?([\\\\/]|$)"
          }
        ]
      }
    },
    "dllName": {
      "description": "A DLL file name in the game folder; the relPath rules apply as well.",
      "allOf": [
        {
          "$ref": "#/$defs/relPath"
        }
      ],
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+\\.[Dd][Ll][Ll]$"
    },
    "api": {
      "enum": [
        "ddraw",
        "d3d8",
        "d3d9",
        "d3d10",
        "d3d11",
        "opengl"
      ]
    },
    "arch": {
      "enum": [
        "x86",
        "x64"
      ]
    },
    "archId": {
      "description": "GPU architecture identifier (ADR 0015): a lowercase letter, then up to 31 lowercase letters, digits or underscores; never \"unknown\" (a profile state, not a value).",
      "type": "string",
      "allOf": [
        {
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        },
        {
          "not": {
            "const": "unknown"
          }
        }
      ]
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exes"
      ],
      "properties": {
        "steam_appid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "exes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/exe"
          }
        }
      }
    },
    "exe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "api"
      ],
      "anyOf": [
        {
          "required": [
            "sha1"
          ]
        },
        {
          "required": [
            "sha256"
          ]
        }
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relPath"
        },
        "sha1": {
          "$ref": "#/$defs/sha1OrTodo"
        },
        "sha256": {
          "$ref": "#/$defs/sha256OrTodo"
        },
        "api": {
          "$ref": "#/$defs/api"
        }
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chain": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "steam",
              "upc",
              "ea-app",
              "rockstar",
              "battlenet",
              "epic",
              "gog-galaxy"
            ]
          }
        },
        "method": {
          "enum": [
            "auto",
            "direct",
            "watch",
            "hold",
            "ifeo",
            "inproc"
          ]
        },
        "fallback": {
          "enum": [
            "direct",
            "watch",
            "hold",
            "ifeo",
            "inproc"
          ]
        },
        "cpu": {
          "$ref": "#/$defs/cpuRuleLaunch"
        },
        "start": {
          "description": "The program of Steam's launch entry (what Steam starts on Play), relative to the game folder; may be a launcher other than the game (P3-3, ADR 0022 amendment P3-3). Required for auto, direct and watch (P4-4); TODO only in a draft.",
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/relPath"
                },
                {
                  "pattern": "\\.[Ee][Xx][Ee]$"
                }
              ]
            },
            {
              "const": "TODO"
            }
          ]
        },
        "priority": {
          "description": "Priority class set by rerun-launch at the start; never realtime. Only when start is the game itself (a launcher passes no priority class on).",
          "enum": [
            "normal",
            "above_normal",
            "high"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "method"
            ],
            "properties": {
              "method": {
                "const": "inproc"
              }
            }
          },
          "else": {
            "properties": {
              "cpu": {
                "not": {
                  "required": [
                    "report_cores"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "method"
            ],
            "properties": {
              "method": {
                "enum": [
                  "auto",
                  "direct",
                  "watch"
                ]
              }
            }
          },
          "then": {
            "required": [
              "start"
            ]
          }
        }
      ]
    },
    "userData": {
      "description": "The game's own folder below a known folder of the user (P4-12, docs/02-topo-format.md, ADR 0007 amendment P4-12): exactly one key, the base (v1 only documents), with the folder below it. The schema checks the form and the allowlist's patterns; the loader checks the allowlist again (user_dir_ok), the opening rules are policy::root's.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documents"
      ],
      "properties": {
        "documents": {
          "allOf": [
            {
              "$ref": "#/$defs/relPath"
            },
            {
              "description": "1 to 4 segments.",
              "pattern": "^[^\\\\/]+([\\\\/][^\\\\/]+){0,3}$"
            },
            {
              "description": "Not the shared My Games alone, not below the folder of a known program that runs an INI file's content or scripts (PowerShell profiles, Rainmeter skins).",
              "not": {
                "anyOf": [
                  {
                    "pattern": "^[Mm][Yy] [Gg][Aa][Mm][Ee][Ss]$"
                  },
                  {
                    "pattern": "^([Ww][Ii][Nn][Dd][Oo][Ww][Ss])?[Pp][Oo][Ww][Ee][Rr][Ss][Hh][Ee][Ll][Ll]([\\\\/]|$)"
                  },
                  {
                    "pattern": "^[Rr][Aa][Ii][Nn][Mm][Ee][Tt][Ee][Rr]([\\\\/]|$)"
                  }
                ]
              }
            }
          ]
        }
      }
    },
    "antiCheatRelease": {
      "description": "Anti-cheat systems of the game that are verifiably dead (P4-4): the engine does not enforce the anti-cheat rule for them. Draft only until reviewed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dead",
        "source"
      ],
      "properties": {
        "dead": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "easy-anti-cheat",
              "battleye",
              "punkbuster",
              "gameguard",
              "xigncode",
              "ea-anticheat"
            ]
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "cpuRule": {
      "description": "CPU rule without report_cores (as a step). Never thread numbers; the one fixed identity is CPU 0, through exclude_first.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "max_threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "prefer": {
          "enum": [
            "performance",
            "any"
          ]
        },
        "single_l3": {
          "type": "boolean"
        },
        "prefer_l3": {
          "enum": [
            "largest"
          ]
        },
        "smt": {
          "type": "boolean",
          "description": "false = only one thread per core."
        },
        "mode": {
          "enum": [
            "hard",
            "soft"
          ]
        },
        "exclude_first": {
          "enum": [
            "thread",
            "core"
          ],
          "description": "thread = never CPU 0 (logical processor 0 of group 0, as Task Manager names it); core = never any thread of the physical core that holds CPU 0. Applied after the L3 choice; a no-op when CPU 0 is not in the chosen group. Use mode: hard for the community fix \"remove CPU 0 access\"."
        }
      }
    },
    "cpuRuleLaunch": {
      "description": "CPU rule in launch.cpu; report_cores only with method: inproc.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "max_threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "prefer": {
          "enum": [
            "performance",
            "any"
          ]
        },
        "single_l3": {
          "type": "boolean"
        },
        "prefer_l3": {
          "enum": [
            "largest"
          ]
        },
        "smt": {
          "type": "boolean",
          "description": "false = only one thread per core."
        },
        "mode": {
          "enum": [
            "hard",
            "soft"
          ]
        },
        "exclude_first": {
          "enum": [
            "thread",
            "core"
          ],
          "description": "thread = never CPU 0 (logical processor 0 of group 0, as Task Manager names it); core = never any thread of the physical core that holds CPU 0. Applied after the L3 choice; a no-op when CPU 0 is not in the chosen group. Use mode: hard for the community fix \"remove CPU 0 access\"."
        },
        "report_cores": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "variants"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "when": {
          "$ref": "#/$defs/when"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "variants": {
          "description": "Empty = \"no known fix\" (a valid answer).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/variant"
          }
        }
      }
    },
    "when": {
      "description": "Conditions against the system profile; multiple fields = AND. gpu.vendor, gpu.arch and gpu.integrated are checked together on each hardware adapter: yes if every adapter says yes, no if every one says no, else unknown (P4-11).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gpu.vendor": {
          "enum": [
            "amd",
            "nvidia",
            "intel"
          ]
        },
        "gpu.arch": {
          "description": "Identifiers declared in the paired GPU architecture table (data/gpu-arch.yaml, ADR 0015).",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/archId"
          }
        },
        "gpu.integrated": {
          "description": "The architecture table's integrated flag of the adapter; a device without a table entry matches neither value (P4-11).",
          "type": "boolean"
        },
        "gpu.hybrid": {
          "description": "At least two hardware adapters (P4-11).",
          "type": "boolean"
        },
        "cpu.threads": {
          "$ref": "#/$defs/compare"
        },
        "cpu.hybrid": {
          "type": "boolean"
        },
        "os.build": {
          "$ref": "#/$defs/compare"
        }
      }
    },
    "compare": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "gt": {
          "type": "integer"
        },
        "gte": {
          "type": "integer"
        },
        "lt": {
          "type": "integer"
        },
        "lte": {
          "type": "integer"
        },
        "eq": {
          "type": "integer"
        }
      }
    },
    "check": {
      "description": "Hint only about a runtime outside the game folder; Rerun installs nothing.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime"
      ],
      "properties": {
        "runtime": {
          "enum": [
            "vcredist-x86",
            "vcredist-x64",
            "directx-jun2010"
          ]
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "kind",
        "steps"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "verified",
            "reported",
            "unverified"
          ]
        },
        "kind": {
          "enum": [
            "fix",
            "enhancement"
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "tradeoffs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "step": {
      "description": "Exactly one primitive. v1: only primitives with a defined spec.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "package": {
          "$ref": "#/$defs/packageId"
        },
        "steam_input": {
          "const": "enable"
        },
        "cpu": {
          "$ref": "#/$defs/cpuRule"
        },
        "registry_set": {
          "$ref": "#/$defs/registrySet"
        },
        "compat_layer": {
          "$ref": "#/$defs/compatLayer"
        },
        "ini_set": {
          "$ref": "#/$defs/iniSet"
        },
        "firewall_rule": {
          "$ref": "#/$defs/firewallRule"
        },
        "laa_patch": {
          "$ref": "#/$defs/laaPatch"
        },
        "gpu_preference": {
          "$ref": "#/$defs/gpuPreference"
        }
      }
    },
    "gpuPreference": {
      "description": "Windows' graphics preference (Settings > System > Display > Graphics) of one executable of match.exes: only the GpuPreference pair of its HKCU UserGpuPreferences value (docs/02-topo-format.md, ADR 0020 amendment P4-11). The schema checks the form; the loader checks that exe is a match.exes entry in exactly its spelling and that the issue's when has gpu.hybrid: true. Reviewed since P4-11.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exe",
        "preference"
      ],
      "properties": {
        "exe": {
          "allOf": [
            {
              "$ref": "#/$defs/relPath"
            },
            {
              "pattern": "\\.[Ee][Xx][Ee]$"
            }
          ]
        },
        "preference": {
          "enum": [
            "high_performance"
          ]
        }
      }
    },
    "laaPatch": {
      "description": "The Large Address Aware flag of one 32-bit executable of match.exes (docs/02-topo-format.md, ADR 0020 amendment P4-10). The schema checks the form; the loader checks that exe is a match.exes entry, in exactly its spelling, with a sha256 (ADR 0024); the planner refuses 64-bit, .NET, protected (SteamStub, SecuROM, SafeDisc, StarForce) and already patched images. Draft only until reviewed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exe"
      ],
      "properties": {
        "exe": {
          "allOf": [
            {
              "$ref": "#/$defs/relPath"
            },
            {
              "pattern": "\\.[Ee][Xx][Ee]$"
            }
          ]
        }
      }
    },
    "firewallRule": {
      "description": "Rerun's block rule for one executable of match.exes (docs/02-topo-format.md, ADR 0023 §6). The schema checks the form; the loader checks that exe is a match.exes entry, in exactly its spelling, with a sha256 (ADR 0024, sha256 for elevated anchors). Draft only until reviewed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exe",
        "direction"
      ],
      "properties": {
        "exe": {
          "allOf": [
            {
              "$ref": "#/$defs/relPath"
            },
            {
              "pattern": "\\.[Ee][Xx][Ee]$"
            }
          ]
        },
        "direction": {
          "description": "Only out for now; in may follow without a format break.",
          "enum": [
            "out"
          ]
        }
      }
    },
    "iniSet": {
      "description": "Keys of an existing INI file of the game folder, or of the Topo's user_data folder with root: user_data (docs/02-topo-format.md, ADR 0021, ADR 0020 amendments P2-12 and P4-12). The schema checks the form; the rule for new values (none of \\ / : % ; # [ ], no ..), unique sections and keys, desktop.ini and the file itself are checked by the loader and the planner.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "values"
      ],
      "properties": {
        "root": {
          "description": "Where the file lies (P4-12): the game folder (default) or the Topo's user_data folder.",
          "enum": [
            "game",
            "user_data"
          ]
        },
        "file": {
          "allOf": [
            {
              "$ref": "#/$defs/relPath"
            },
            {
              "pattern": "\\.[Ii][Nn][Ii]$"
            }
          ]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/iniValue"
          }
        }
      }
    },
    "iniValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section",
        "key",
        "value"
      ],
      "properties": {
        "section": {
          "$ref": "#/$defs/iniName"
        },
        "key": {
          "$ref": "#/$defs/iniName"
        },
        "value": {
          "description": "1 to 128 printable ASCII characters, no space at either end.",
          "type": "string",
          "pattern": "^[\\x21-\\x7e]([\\x20-\\x7e]{0,126}[\\x21-\\x7e])?$"
        }
      }
    },
    "iniName": {
      "description": "A section or key name: A-Z a-z 0-9 _ . - and space, 1 to 64 characters, no space at either end.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]([A-Za-z0-9_. -]{0,62}[A-Za-z0-9_.-])?$"
    },
    "compatLayer": {
      "description": "Compatibility-layer tokens for an executable of the game folder in HKCU\\...\\AppCompatFlags\\Layers (docs/02-topo-format.md, ADR 0018 amendment P2-11). The schema checks the form; the token allowlist (docs/05-sources-policy.md, Reference data), the groups and the executable itself are checked by the loader and the planner.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exe",
        "layers"
      ],
      "properties": {
        "exe": {
          "allOf": [
            {
              "$ref": "#/$defs/relPath"
            },
            {
              "pattern": "\\.[Ee][Xx][Ee]$"
            }
          ]
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]{1,40}$"
          }
        }
      }
    },
    "registrySet": {
      "description": "Values below HKCU\\Software\\<Vendor>\\<Product>[\\...] (docs/02-topo-format.md, ADR 0018). The schema checks the form; the vendor deny list, unique names and the qword range are checked by the loader and the planner.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "values"
      ],
      "properties": {
        "key": {
          "description": "HKCU\\Software, then <Vendor>, <Product> and at most 4 more segments: 1 to 64 printable ASCII characters without a backslash or a space at either end.",
          "type": "string",
          "pattern": "^HKCU\\\\Software(\\\\[\\x21-\\x5b\\x5d-\\x7e]([\\x20-\\x5b\\x5d-\\x7e]{0,62}[\\x21-\\x5b\\x5d-\\x7e])?){2,6}$"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/registryValue"
          }
        }
      }
    },
    "registryValue": {
      "description": "A value name and exactly one of dword, qword (a decimal string), sz.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "description": "Printable ASCII without \\ / : % and without a space at either end; empty is the default value.",
          "type": "string",
          "maxLength": 128,
          "pattern": "^([\\x21-\\x24\\x26-\\x2e\\x30-\\x39\\x3b-\\x5b\\x5d-\\x7e]([\\x20-\\x24\\x26-\\x2e\\x30-\\x39\\x3b-\\x5b\\x5d-\\x7e]*[\\x21-\\x24\\x26-\\x2e\\x30-\\x39\\x3b-\\x5b\\x5d-\\x7e])?)?$"
        },
        "dword": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "qword": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "sz": {
          "description": "Printable ASCII without \\ / : % (no paths, no variables), at most 1,024 characters.",
          "type": "string",
          "maxLength": 1024,
          "pattern": "^[\\x20-\\x24\\x26-\\x2e\\x30-\\x39\\x3b-\\x5b\\x5d-\\x7e]*$"
        }
      },
      "oneOf": [
        {
          "required": [
            "dword"
          ]
        },
        {
          "required": [
            "qword"
          ]
        },
        {
          "required": [
            "sz"
          ]
        }
      ]
    },
    "source": {
      "description": "Direct link to a guide, thread, repo or section - never just the home page.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "url"
      ],
      "properties": {
        "type": {
          "enum": [
            "repo",
            "steam-guide",
            "steam-thread",
            "pcgw",
            "official"
          ]
        },
        "url": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "repo"
              }
            }
          },
          "then": {
            "properties": {
              "url": {
                "pattern": "^https://(github\\.com|gitlab\\.com|codeberg\\.org)/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(/[^\\s]*)?$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "steam-guide"
              }
            }
          },
          "then": {
            "properties": {
              "url": {
                "pattern": "^https://steamcommunity\\.com/sharedfiles/filedetails/\\?id=[0-9]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "steam-thread"
              }
            }
          },
          "then": {
            "properties": {
              "url": {
                "pattern": "^https://steamcommunity\\.com/(app/[0-9]+|groups/[A-Za-z0-9_-]+)/discussions/[0-9]+/[0-9]+/?$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "pcgw"
              }
            }
          },
          "then": {
            "properties": {
              "url": {
                "pattern": "^https://www\\.pcgamingwiki\\.com/wiki/[^\\s#]+(#[^\\s]+)?$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "official"
              }
            }
          },
          "then": {
            "properties": {
              "url": {
                "pattern": "^https://[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*\\.[a-z]{2,63}/[^\\s\\\\]+$"
              }
            }
          }
        }
      ]
    },
    "tips": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "launch_options": {
          "description": "Single game arguments that Rerun places after %command%. No commands, no %, no quotes.",
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[-+][A-Za-z0-9_.=+-]+$"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "$ref": "#/$defs/source"
              }
            }
          }
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pcgw": {
          "description": "PCGamingWiki page name, not a URL.",
          "type": "string",
          "pattern": "^[^\\s/?#]+$"
        }
      }
    }
  }
}
